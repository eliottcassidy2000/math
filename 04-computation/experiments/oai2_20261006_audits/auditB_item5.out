    p=3: level v=0 -> 2, v=1 -> 2  (p-1 = 2)
    p=5: level v=0 -> 4, v=1 -> 4  (p-1 = 4)
    p=7: level v=0 -> 6, v=1 -> 6  (p-1 = 6)
    p=11: level v=0 -> 10, v=1 -> 10  (p-1 = 10)
