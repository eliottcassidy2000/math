== -7/4 and -29/16 (sympy) ==
  c = -7/4: (f^3 - x)/(f - x) = (8*x**3 + 4*x**2 - 18*x - 1)**2/64
     cubic factor 8*x**3 + 4*x**2 - 18*x - 1 (mult 2): roots [-1.7469796, -0.054958132, 1.3019377], multiplier prod 2x_i = 8*CRootOf(8*x**3 + 4*x**2 - 18*x - 1, 0)*CRootOf(8*x**3 + 4*x**2 - 18*x - 1, 1)*CRootOf(8*x**3 + 4*x**2 - 18*x - 1, 2)
  c = -29/16: (f^3 - x)/(f - x) = (4*x - 5)*(4*x + 1)*(4*x + 7)*(64*x**3 + 16*x**2 - 164*x + 23)/4096
     cubic factor 64*x**3 + 16*x**2 - 164*x + 23 (mult 1): roots [-1.7919362, 0.14340091, 1.3985353], multiplier prod 2x_i = 8*CRootOf(64*x**3 + 16*x**2 - 164*x + 23, 0)*CRootOf(64*x**3 + 16*x**2 - 164*x + 23, 1)*CRootOf(64*x**3 + 16*x**2 - 164*x + 23, 2)
  c(c+1)^2 at c=-7/4: -63/64  f^3(0) = -7/256
  x^2 - 29/16 orbit of -7/4: [-7/4, 5/4, -1/4, -7/4]

