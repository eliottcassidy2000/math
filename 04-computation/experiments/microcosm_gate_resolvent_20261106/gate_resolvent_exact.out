Gamma marked resolvent, p_Gamma = p_E, phi(D T) = phi(T), phi(E T) = 1, phi(Gamma T) = (5 phi + 1)/(phi + 1): True
k = 0 gates: phi = 1 ; Fib(2k+2)/Fib(2k-1) = 1/1 : True
