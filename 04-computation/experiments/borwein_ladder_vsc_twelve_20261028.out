==============================================================================
  {d+1 : d | 12} = [2, 3, 4, 5, 7, 13] ; primes = vSC(12) = [2, 3, 5, 7, 13] ; B_12 = -691/2730 ; vSC(10) = [2, 3, 11], B_10 = 5/66
