  TournamentH7.LRCWindowData — THE PACK-LIST DISPATCHER (kind-pasteur-2026-07-02-S17,
  HYP-3974).  Single-writer satellite.

  The window leg's last piece (klein-S111): discharge `hdistinct20` — every strictly
  monotone positive covering 13-tuple `≤ 20` is lonely — from row DATA.  Design points:

  * ROWS AS PLAIN-LIST DATA (`WinRow`: speeds `List ℤ`, witness `num/den`), not `![…]`
    tuple literals: the S47 crash lived in per-row theorem elaboration; here the whole
    band is a `List` value and ONE gate evaluation.
  * SOUNDNESS through opus's kernel gate (`lonely_of_kernelWitness`, kernel-pure).
  * COMPLETENESS by enumeration: every candidate is a length-13 sublist of `[1,…,20]`
    (strictly monotone + bounded ⟹ sublist, via the sorted-subset bridge lemma), and
    one `native_decide` checks every covering candidate has a row.
  * PRIMITIVITY IS AUTOMATIC at `W = 20`: thirteen DISTINCT positive entries with a
    common divisor `g ≥ 2` would need `max ≥ 13·2 = 26 > 20` — so the `tupleGcd`
    hypothesis is never needed and the enumeration filter is covering-ness alone.
-/
import TournamentH7.LRCKernelGate
import TournamentH7.LRC14WindowWiring
import TournamentH7.HWindow20
import TournamentH7.LRC14ConcreteSurface

namespace LonelyRunner
namespace WindowData

/-- One bounded-window census row: thirteen speeds and an exact rational witness. -/
structure WinRow where
  speeds : List ℤ
  num    : ℤ
  den    : ℕ
deriving Repr, DecidableEq

/-- The decidable row check: positive denominator, thirteen speeds, every speed clears
the integer kernel gate at the witness. -/
def winRowOK (r : WinRow) : Prop :=
  0 < r.den ∧ r.speeds.length = 13 ∧ ∀ s ∈ r.speeds, KernelGate.speedOK s r.num r.den

instance (r : WinRow) : Decidable (winRowOK r) := by
  unfold winRowOK
  infer_instance

/-- Row soundness (kernel-pure): a passing row certifies any tuple reading off its
speeds. -/
theorem winRow_lonely (r : WinRow) (hOK : winRowOK r) (v : Fin 13 → ℤ)
    (hv : ∀ i, v i = r.speeds.getD (i : ℕ) 0) :
    Lonely 14 v ((((r.num : ℚ) / (r.den : ℚ)) : ℚ) : ℝ) := by
  obtain ⟨hden, hlen, hall⟩ := hOK
  apply KernelGate.lonely_of_kernelWitness hden
  intro i
  rw [hv i]
  apply hall
  have hlt : (i : ℕ) < r.speeds.length := by rw [hlen]; exact i.isLt
  rw [List.getD_eq_getElem r.speeds 0 hlt]
  exact List.getElem_mem hlt

