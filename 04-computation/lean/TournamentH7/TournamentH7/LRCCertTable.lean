theorem page12_ok : ∀ K ∈ page12, rowOK (1/14) K := by native_decide

/-- **The k = 12 page, quantified.** -/
theorem page12_tail (K : CertRow) (hK : K ∈ page12) (V : ℤ) (hV : K.Vs ≤ V) :
    ∃ τ : ℝ,
      (∀ s ∈ K.P, ((1/14 : ℚ) : ℝ) ≤ ‖(((s : ℝ) * τ : ℝ) : UnitAddCircle)‖) ∧
      (∀ o ∈ K.offs, ((1/14 : ℚ) : ℝ) ≤ ‖((((V - o : ℤ) : ℝ) * τ : ℝ) : UnitAddCircle)‖) :=
  row_tail (by norm_num) K (page12_ok K hK) V hV

end WitnessCert
