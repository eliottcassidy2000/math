/-
  TournamentH7.LRCCertTable — the mass certificate table (the (star)-census, Lean face).
  kind-pasteur-2026-07-02-S3 (HYP-3960; DAG critical-path item 3, kps-assigned).

  A census page becomes ONE theorem: each row carries a shape (P, offs), a ruler phase c, one
  safe arc [lo, hi], and a tail threshold V*; `rowOK` is the decidable conjunction of all the
  `arcSafe` checks plus the width bound (V* : ℚ) * (hi − lo) > 1; `table_ok` discharges the whole
  page by `native_decide`; `table_tail` is the quantified corollary — for every row and EVERY
  reference speed V ≥ V*, a common h-lonely time exists.  Rows are generated and exactly verified
  by the Python census engine (lrc14_star_census_run_kps.py).
-/
import TournamentH7.LRCWitnessCert

namespace LonelyRunner
namespace WitnessCert

/-- One census row: shape, phase, arc, tail threshold. -/
structure CertRow where
  P    : List ℤ
  offs : List ℤ
  c    : ℚ
  lo   : ℚ
  hi   : ℚ
  Vs   : ℤ
deriving Repr

/-- The decidable row check: positivity, safety of every speed and offset on the arc, and the
tail-threshold width bound. -/
def rowOK (h : ℚ) (K : CertRow) : Prop :=
  (∀ s ∈ K.P, 0 ≤ s) ∧ (∀ o ∈ K.offs, 0 ≤ o) ∧
  (∀ s ∈ K.P, arcSafe h s 0 K.lo K.hi) ∧
  (∀ o ∈ K.offs, arcSafe h o K.c K.lo K.hi) ∧
  (0 < K.Vs) ∧ (1 < (K.Vs : ℚ) * (K.hi - K.lo))

instance (h : ℚ) (K : CertRow) : Decidable (rowOK h K) := by
  unfold rowOK; infer_instance

/-- The quantified tail theorem for ANY checked row: every reference speed `V ≥ V*` admits a
common `h`-lonely time for the whole shape. -/
theorem row_tail {h : ℚ} (h0 : 0 ≤ h) (K : CertRow) (hK : rowOK h K)
    (V : ℤ) (hV : K.Vs ≤ V) :
    ∃ τ : ℝ,
      (∀ s ∈ K.P, (h : ℝ) ≤ ‖(((s : ℝ) * τ : ℝ) : UnitAddCircle)‖) ∧
      (∀ o ∈ K.offs, (h : ℝ) ≤ ‖((((V - o : ℤ) : ℝ) * τ : ℝ) : UnitAddCircle)‖) := by
  obtain ⟨hP, hO, hPs, hOs, hVs, hlen⟩ := hK
  have hwidth : 0 < K.hi - K.lo := by
    rcases le_or_gt (K.hi - K.lo) 0 with hneg | hpos
    · exfalso
      have h1 : (K.Vs : ℚ) * (K.hi - K.lo) ≤ 0 :=
        mul_nonpos_of_nonneg_of_nonpos (by exact_mod_cast hVs.le) hneg
      linarith
    · exact hpos
  have hVQ : (K.Vs : ℚ) ≤ (V : ℚ) := by exact_mod_cast hV
  have hVlen : 1 < (V : ℚ) * (K.hi - K.lo) := by
    have := mul_le_mul_of_nonneg_right hVQ hwidth.le
    linarith
  exact cert_lonely_tail h0 K.P K.offs hP hO hPs hOs V hVlen (by omega)


