/-- The whole k = 13 census page checks. -/
theorem page13_ok : ∀ K ∈ page13, rowOK (1/14) K := by native_decide

/-- **The k = 13 page, quantified**: every window-14 pure-cluster pattern is 1/14-lonely for
every reference speed above its row threshold. -/
theorem page13_tail (K : CertRow) (hK : K ∈ page13) (V : ℤ) (hV : K.Vs ≤ V) :
    ∃ τ : ℝ,
      (∀ s ∈ K.P, ((1/14 : ℚ) : ℝ) ≤ ‖(((s : ℝ) * τ : ℝ) : UnitAddCircle)‖) ∧
      (∀ o ∈ K.offs, ((1/14 : ℚ) : ℝ) ≤ ‖((((V - o : ℤ) : ℝ) * τ : ℝ) : UnitAddCircle)‖) :=
  row_tail (by norm_num) K (page13_ok K hK) V hV


