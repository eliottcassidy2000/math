Cell["\<\
P1[S_] := 
{2 S[[1, 4, 3, 4]], 2 S[[3, 2, 3, 4]], 2 S[[2, 4, 3, 4]], 2 S[[3, 1, 3, 4]]}\
\>", "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"f267c4d4-3d2b-4a68-91d2-002ae56e1418"],

Cell["\<\
P2[S_] := 
{
{2S[[1, 4, 1, 4]], (2S[[1, 2, 3, 4]] + 2S[[1, 4, 3, 2]]), 
2S[[1, 4, 2, 4]], 2S[[1, 4, 3, 1]]},
{(2S[[1, 2, 3, 4]] + 2S[[1, 4, 3, 2]]), 2S[[3, 2, 3, 2]], 
2S[[2, 4, 3, 2]], 2S[[3, 1, 3, 2]]},
{2S[[1, 4, 2, 4]], 2S[[2, 4, 3, 2]], 
2S[[2, 4, 2, 4]], (2S[[2, 1, 3, 4]] + 2S[[2, 4, 3, 1]])},
{2S[[1, 4, 3, 1]], 2S[[3, 1, 3, 2]], 
(2S[[2, 1, 3, 4]] + 2S[[2, 4, 3, 1]]), 2S[[3, 1, 3, 1]]}
}\
\>", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"a6637447-6f48-4a62-8fde-acb5a1956270"],

