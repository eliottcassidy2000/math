}], "Text",ExpressionUUID->"c3b01c9d-4b90-4db9-8b4a-dced52514b55"],

Cell["\<\
hcd=-Sqrt[3]/4(q1z q2x + q1x q2z) ArcTan[Sin[2 \
\[Theta]]/Sqrt[3]]*Transpose[K[ez]] . K[ez]+
    2 q1z q2z Sin[\[Theta]] Cos[\[Theta]]/(4-Cos[2 \
\[Theta]]^2)*(Transpose[K[ex]] . K[ez] + Transpose[K[ez]] . K[ex])/2 ; \
\>", "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"f02ab600-321c-453d-a3b6-baa44fc7fa49"]
}, Open  ]],

