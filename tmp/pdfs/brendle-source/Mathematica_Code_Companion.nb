              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"3", "*"}]]], 
             StyleBox["A", "TI"]}], ")"}], ","}]], "InlineFormula",
          ExpressionUUID->"4825b219-b00e-4b4e-ac30-dba28d7be038"],
         " "
        }],ExpressionUUID->"e5fc324d-81b3-48dc-b914-db9e548789b5"]},
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "2"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"1cd00d56-83a5-4d59-b1a4-3d7d63a172a1"],
         " "
        }],ExpressionUUID->"efd49a80-09da-49b1-8a41-b7f470bd9a90"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           FractionBox["1", "cos\[Theta]"], 
           RowBox[{"(", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               RowBox[{"*", "\[LongEqual]"}], 
               StyleBox["x", "TI"], ",", 
               StyleBox["y", "TI"], ",", 
               StyleBox["z", "TI"]}],
              LimitsPositioning->True], 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"1", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"3", "*"}]]], 
             StyleBox["A", "TI"], "-", 
             SubscriptBox[
              StyleBox["q", "TI"], 
              RowBox[{"3", "*"}]], 
             SubscriptBox["\[PartialD]", 
              SubscriptBox[
               StyleBox["q", "TI"], 
               RowBox[{"1", "*"}]]], 
             StyleBox["A", "TI"]}], ")"}], ","}]], "InlineFormula",
          ExpressionUUID->"3066fef5-748b-4c11-a56e-c9599b5cbbe2"],
         " "
        }],ExpressionUUID->"17e5f8c4-2ed8-4fea-8f0a-9116f5339abb"]},
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "3"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"5824ba07-c827-4ba4-8c8e-548042f9ceba"],
         " "
        }],ExpressionUUID->"7ea3d509-c013-469b-98e6-2cc8267e27f2"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           UnderscriptBox["\[Sum]", 
            RowBox[{
             RowBox[{"*", "\[LongEqual]"}], 
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"], ",", 
