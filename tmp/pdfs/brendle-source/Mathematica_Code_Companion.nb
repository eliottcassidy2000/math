Cell[TextData[{
 "the Mathematica definitions ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"metric", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1e0ea50d-2f5e-46f3-8439-b5c899d3b059"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "25f9585b-c609-4f87-b8c9-cadffc78cc54"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"inversemetric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d3d05d50-1079-49e3-a84e-7fd5ef6e11bd"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "68ee753b-4f15-4326-8a2f-51c82d49df23"],
 " are as follows:"
}], "Text",ExpressionUUID->"4deac68f-7b4c-4061-a406-dba238036e14"],

Cell["\<\
metric = {
{1/(2 - Cos[2 \[Theta]]), 0, 0, 0},
{0, 1/(2 + Cos[2 \[Theta]]), 0, 0},
{0, 0, 1/3, 0},
{0, 0, 0, 1}
};
inversemetric=Inverse[metric];\
\>", "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"e2b72b14-b516-4221-a51e-90296931f346"],

Cell[TextData[{
