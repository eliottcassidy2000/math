Cell["\<\
rb=P1[L[hb]]//Simplify;
zb=-Inverse[H].rb//Simplify;
Vbb=P0[L[hbb]]+P0[Q[hb,hb]]+1/2rb.zb;
Vbb=FullSimplify[Vbb,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"17d053f1-cc6b-4e29-bdcd-e5abafe6edea"],

