       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["III",
         FontSlant->"Plain"]]}], ")"}], 
     StyleBox[
      RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"Cubic", "[", 
       RowBox[{"h1", ",", "h2", ",", "h3"}], "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], " ", "]"}],
     FontSlant->"Plain"]}], TraditionalForm]], "InlineFormula",ExpressionUUID->
  "8cba4f55-6ddc-4d63-b620-6309c6ef9aae"],
 "  "
}], "DisplayFormula",ExpressionUUID->"48d11a90-601d-4e46-bba8-f68eb7b69146"],

Cell["\<\
Cubic[h1_,h2_,h3_] := Module[{T2,T3},
T2=T[h2];
T3=T[h3];
Table[
Sum[
inversemetric[[m,m]]*inversemetric[[r,r]]*h1[[m,r]]*
(-T2[[j,k,m]]*T3[[i,l,r]]+T2[[i,k,m]]*T3[[j,l,r]]),
{m,1,4},{r,1,4}
],
{i,1,4},{j,1,4},{k,1,4},{l,1,4}
]
]\
\>", "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"f977fecb-5f5a-45e7-83b3-7f7f890c54b9"],

