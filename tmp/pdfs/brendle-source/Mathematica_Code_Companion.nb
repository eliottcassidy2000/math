Cell["\<\
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
Vdd=P0[L[hdd]]+P0[Q[hd,hd]]+1/2rd.zd;
Vdd=Collect[Vdd//Expand,{q1z^2 q3x^2, q2z^2 q3x^2, q1x q1z q3x q3z},Simplify];\
\>", "Input",
 CellLabel->"In[99]:=",ExpressionUUID->"49644f7b-27e7-4d9d-be0c-5dbfcda75733"],

