Cell["\<\
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
A41=2P1[Q[hc,hd]].zd;
A42=1/2*Transpose[zd].P2[L[hc]].zd;
A4=A41+A42;\
\>", "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"418ce5ac-b8d8-4bf0-a6d1-ddb067e6ff04"],

