Cell["\<\
VddExp= (3 + 4 Cos[2 \[Theta]] - Cos[4 \[Theta]])/(24 (2 + Cos[2 \
\[Theta]])^3)*q1z^2*q3x^2 +
        (3 - 4 Cos[2 \[Theta]] - Cos[4 \[Theta]])/(24 (2 - Cos[2 \
\[Theta]])^3)*q2z^2*q3x^2+
        (11 Cos[2 \[Theta]] + Cos[6 \[Theta]])/(3(7 - Cos[4 \
\[Theta]])^2)*(-q1x*q1z+q2x*q2z)*q3x*q3z;
(Vdd-VddExp//Simplify) == 0\
\>", "Input",
 CellLabel->
  "In[103]:=",ExpressionUUID->"6b55970b-44f9-48ab-90e7-f55a851a6d38"],

