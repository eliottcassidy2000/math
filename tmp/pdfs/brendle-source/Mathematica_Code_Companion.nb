Cell[TextData[{
 "They are represented by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["ha",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "489498a2-6e42-47ab-a037-72cf7ffd4d17"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "c6cef77f-d3e1-4963-bdf3-41aaa2b19514"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["hb",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ac54fab3-2a54-4bc5-b30b-d1957737686c"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a9596a2a-9430-4824-985a-972037616554"],
 " respectively, and are defined in Mathematica as follows:"
}], "Text",ExpressionUUID->"6fb86e67-3ae4-4a75-85fd-a41f6d5a4774"],

Cell["\<\
ha = 6 / 5*(2 - Cos[2 \[Theta]])*
     (Transpose[Kp] . K[ex] + Transpose[K[ex]] . Kp)/2 -
   2*(1 - Cos[2 \[Theta]])*(2 + Cos[2 \[Theta]])*
   (Transpose[Km] . J[ex] + Transpose[J[ex]] . Km)/2 // Simplify;
hb = 6 / 5*(2 + Cos[2 \[Theta]])* 
     (Transpose[Km] . K[ey] + Transpose[K[ey]] . Km)/2 -
   2*(1 + Cos[2 \[Theta]]) (2 - Cos[2 \[Theta]])* 
   (Transpose[Kp] . J[ey] + Transpose[J[ey]] . Kp)/2 // Simplify;\
\>", "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"632268e1-ffd9-4e5a-a433-c4f1be058d63"],

