Cell[CellGroupData[{
Cell[TextData[{
 "Mathematica code companion: \"A metric on ",
 Cell[BoxData[Cell[TextData[{
   Cell[BoxData[
    FormBox[
     RowBox[{
      SuperscriptBox[
       StyleBox["S", "TI"], "2"], "\[Cross]", 
      SuperscriptBox[
       StyleBox["S", "TI"], "2"]}], TraditionalForm]], "InlineFormula",
    ExpressionUUID->"9ef48e17-033d-4386-a5f9-6923c462b0aa"],
   "  "
  }], "DisplayFormula",ExpressionUUID->
   "c8a9d35c-9a89-4c7c-8cc4-3e118eb8155b"]],ExpressionUUID->
  "c934ffbb-ddee-44c0-b48f-5c862c6fb8ea"],
 " with positive sectional curvature.\""
}], "Title",ExpressionUUID->"f7a55e7b-b42c-4c27-81df-8668496afad1"],

Cell[CellGroupData[{

Cell["Connection and Curvature", "Chapter",ExpressionUUID->"7b2e34eb-75ee-44fb-99fd-4d8dab75c53c"],

Cell[TextData[{
 "This section contains the codes for computing the connection and Riemannian \
curvature tensor of the M\[UDoubleDot]ter metric. Recall that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "e5d21833-01d3-4afe-a5f4-b1d384e47e68"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "7ea3a105-4fa5-41aa-9347-0f3637167568"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["i", "TI"], 
     RowBox[{
      RowBox[{"\[LongEqual]", "1"}], ",", "2", ",", "3", ",", "4"}]}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f4cd93a6-cdfc-441e-808b-8ecce7be88a0"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "29418411-62b3-4c66-8582-1e03b6181e0c"],
 " are vector fields defined on ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], "\[Cross]", 
     SuperscriptBox[
      StyleBox["S", "TI"], "2"], "\\", 
     SubscriptBox["\[CapitalDelta]", "\[PlusMinus]"]}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"adef4aaa-5994-427d-8630-f1d7c383c2ae"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "33473de1-e8da-4aa2-9aca-648a29c2d7ee"],
 ". We write ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"b7067bb3-8669-4367-a2d3-8631b3fa0261"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "9c550374-a6a8-42d4-a167-eff987e97725"],
 " for ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["g", "TI"], "(", 
     RowBox[{
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["i", "TI"]], ",", 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["j", "TI"]]}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"89450d5e-3643-4237-a6f5-160b4d5ad31a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "adcd7bfa-9cef-4bc4-bf98-08513cb7a510"],
 ", and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f93ccafd-c37c-454d-912e-e614df789d6e"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "82eda00e-8329-43af-ba7a-97c6cd4f5537"],
 " for the inverse metric. In Mathetmatica, ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6206648f-50e2-49b4-b757-8a90aab620b2"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "c091cb3a-a796-4997-b48d-01a8200d7301"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SuperscriptBox[
     StyleBox["g", "TI"], 
     StyleBox[
      RowBox[{"i", "j"}], "TI"]], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6d7545e3-cecd-4f3f-8602-cb45e950dcd8"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4c23d44f-d315-4c56-8084-b6ed3b78278b"],
 " are represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"metric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a981de6e-d999-48a0-96a9-1f5596aea7b5"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "7e23b77a-9222-4068-b8f4-2c8cf08d322a"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"inversemetric", " ", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "9d31743d-918b-4b7a-8a02-de010d50742d"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "74c3df03-6160-4f5e-84da-ae06554b6eee"],
 " respectively:"
}], "Text",ExpressionUUID->"bd77fc15-08f7-44cd-933c-0b5e8647dd0a"],

