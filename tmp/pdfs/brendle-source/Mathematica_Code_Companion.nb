Cell["\<\
ra=P1[L[ha]]//Simplify;
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
Vad=P0[L[had]]+P0[Q[ha,hd]]+1/2ra.zd;
