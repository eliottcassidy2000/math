Cell["\<\
K[u_] := {{Sin[\[Theta]] Dot[q1, u], Cos[\[Theta]] Dot[q2, u], Dot[q3, u], \
0}} . metric;
J[u_] := {{Cos[\[Theta]] Dot[q2, u], Sin[\[Theta]] Dot[q1, u], 0, -Dot[q3, \
u]}} . metric;
Kp = {{2 Cos[\[Theta]]*Sin[\[Theta]], 0, 0, 0}} . metric;
Km = {{0, 2 Cos[\[Theta]]*Sin[\[Theta]], 0, 0}} . metric;\
\>", "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"a0f9673d-c5d5-433a-ab93-cc3c975723e4"],

