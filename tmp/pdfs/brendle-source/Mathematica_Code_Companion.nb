Cell["\<\
ra=P1[L[ha]]//Simplify;
za=-Inverse[H].ra//Simplify;
Vaa=P0[L[haa]]+P0[Q[ha,ha]]+1/2ra.za;
Vaa=FullSimplify[Vaa,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->"In[65]:=",ExpressionUUID->"6e8eea0b-5e0f-4ba6-9232-301c0e214939"],

Cell["We then verify that", "Text",ExpressionUUID->"e4dfa69e-18c7-4af3-9938-649a5f364e13"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox[
     StyleBox["V", "TI"], 
     StyleBox[
      RowBox[{"a", "a"}], "TI"], 
     RowBox[{"(", "2", ")"}]], "\[LongEqual]", 
    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox["3472117", "384"], "+", 
      FractionBox["42025", "6"], 
      SqrtBox[
       FractionBox["5", "3"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["q", "TI"], "3"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], 
