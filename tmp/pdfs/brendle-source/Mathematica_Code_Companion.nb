        }],ExpressionUUID->"56f296ac-db2c-4a1f-b59f-52359421d9f3"]}
      }], TraditionalForm]],ExpressionUUID->
    "0aff5365-3ec7-4bd3-84b7-1ef86d4544e7"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"f231e059-1aad-45c9-a1cf-6b815f2e621e"],
 "  "
}], "DisplayFormula",ExpressionUUID->"c62d86ea-4d52-471c-a59e-eae515200934"],

Cell["and", "Text",ExpressionUUID->"bd63d767-6e13-45f1-a931-3cf2747253ee"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["m", "TI"], "4"], 
    StyleBox["A", "TI"], "\[LongEqual]", 
    SubscriptBox["\[PartialD]", "\[Theta]"], 
    StyleBox["A", "TI"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"b62c0e48-77d7-473b-8133-cdcaf449f263"],
 "  "
}], "DisplayFormula",ExpressionUUID->"6e9ec44b-3b6e-400e-8eec-d35459bfef83"],

Cell[TextData[{
 "Then the Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["frameD",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "bd6c9676-5a16-4db7-87e5-fa3ec407fc8b"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4133b158-4e24-4dfe-9114-9ed0267514d9"],
 " is as follows:"
}], "Text",ExpressionUUID->"2a913fb8-035e-4464-976b-8891c56ad822"],

Cell["\<\
frameD[1, expr_] := (
q3x*D[expr, q2x] + q3y*D[expr, q2y] + q3z*D[expr, q2z] -
q2x*D[expr, q3x] - q2y*D[expr, q3y] - q2z*D[expr, q3z]
     )/Sin[\[Theta]];
frameD[2, expr_] := (
q1x*D[expr, q3x] + q1y*D[expr, q3y]+ q1z*D[expr, q3z] -
q3x*D[expr, q1x] - q3y*D[expr, q1y] - q3z*D[expr, q1z]
     )/Cos[\[Theta]];
frameD[3, expr_] := (
q2x*D[expr, q1x] + q2y*D[expr, q1y] + q2z*D[expr, q1z] -
q1x*D[expr, q2x] - q1y*D[expr, q2y] - q1z*D[expr, q2z]
    );
frameD[4, expr_] := D[expr, \[Theta]];\
\>", "Input",
 CellLabel->"In[17]:=",ExpressionUUID->"5980bafc-be96-426c-8a06-220cfdc8e827"],

Cell[TextData[{
 "Let ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "f5740996-cb36-4563-a0b8-5a9539547360"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "d07d769a-5f72-4ff0-9379-caf299ec362c"],
 " be the connection coefficients given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["D", "TI"], 
      SubscriptBox[
       StyleBox["m", "TI"], 
       StyleBox["i", "TI"]]], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     SubsuperscriptBox["\[CapitalGamma]", 
      StyleBox[
       RowBox[{"i", "j"}], "TI"], 
      StyleBox["k", "TI"]], 
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["k", "TI"]], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"30c26f87-09a0-49b1-af9b-9e7ba6c36c06"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"0bddf766-6b3d-47fb-8827-060342179770"]
}], "Text",ExpressionUUID->"9dcaabae-bcc4-45d4-8921-e5b5b3d2a65b"],

Cell[TextData[{
 "In Mathematica ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "5c21f0f0-10b7-4cdc-b6d3-41dbb97a0822"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "795ddfe0-724c-402c-870e-a5d0b6ef65af"],
 " is represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["Connection",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "7bb64700-2f1d-41c4-b4f5-187013543237"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "d40263b6-7ac9-4062-b3dc-ae00c531d086"],
 ":"
}], "Text",ExpressionUUID->"c52ac440-3d48-4639-ae66-f6b7e2c3db51"],

