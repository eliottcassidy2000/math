Cell["\<\
rd=P1[L[hd]]//Simplify;
rcd=P1[L[hcd]];
zd=-Inverse[H].rd//Simplify;
A3=4*(P0[Q[hcd,hd]]+1/2*rcd.zd);\
\>", "Input",
 CellLabel->
  "In[152]:=",ExpressionUUID->"a39ca85d-ecba-4800-ac53-36a79cbb7672"],

