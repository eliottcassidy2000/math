    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox["3472117", "384"], "+", 
      FractionBox["42025", "6"], 
      SqrtBox[
       FractionBox["5", "3"]]}], ")"}], 
    SuperscriptBox[
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       SubscriptBox[
        StyleBox["q", "TI"], "3"], ",", 
       SubscriptBox[
        StyleBox["e", "TI"], 
        StyleBox["y", "TI"]]}], "\[RightAngleBracket]"}], "2"], "."}], 
   TraditionalForm]], "InlineFormula",ExpressionUUID->
  "2dfd2aa6-9694-4f06-9f57-0576b1476fc0"],
