Cell[TextData[{
 "The following code uses the Koszul formula to compute ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Connection", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "aea086e0-73ac-433f-b0b6-8b7ff4b2f512"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "b98e1c24-dc50-41b7-8da2-8e83832bb4fd"],
 ":"
}], "Text",ExpressionUUID->"03dc9fd6-6230-426e-a521-cab17de9e58e"],

Cell["\<\
Connection=Table[
1/2(
frameD[i, metric[[j, k]]] + frameD[j, metric[[i, k]]] - frameD[k, metric[[i, \
j]]] + 
cLow[[i, j, k]] - cLow[[j, k, i]] + cLow[[k, i, j]]
)*inversemetric[[k,k]],
{i,1,4},{j,1,4},{k,1,4}
];\
\>", "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"3937dbd3-9905-454c-aca7-da90ecfe9261"],

Cell[TextData[{
 "The Riemannian curvature tensor is given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     StyleBox["g", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["i", "TI"]]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["j", "TI"]]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["j", "TI"]]], 
       SubscriptBox[
        StyleBox["D", "TI"], 
        SubscriptBox[
         StyleBox["m", "TI"], 
         StyleBox["i", "TI"]]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        RowBox[{"[", 
         RowBox[{
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["i", "TI"]], ",", 
          SubscriptBox[
           StyleBox["m", "TI"], 
           StyleBox["j", "TI"]]}], "]"}]], 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["l", "TI"]], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "."}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"163fc3e1-a628-45ad-8a96-1684cd4b43f3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "ec8ea953-ccb0-45b0-9df9-c34fd91c1f2b"],
 " In Mathematica ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["R", "TI"], 
     StyleBox[
      RowBox[{"i", "j", "k", "l"}], "TI"]], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"dc07af4b-ad12-4737-b934-7c59edbb6374"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "3ebad82a-9663-4fcf-aa0e-4650ccb6574e"],
 " is represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Rm", "[", " ", 
      RowBox[{"[", " ", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], " ", "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "92c96bed-2c64-4883-9556-9a4ed21f8fd3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "31bdc426-5702-448b-bca1-1bfdd1446faa"],
 ": ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     StyleBox[
      RowBox[{"Rm", "[", " ", 
       RowBox[{"[", " ", 
        RowBox[{"i", ",", "j", ",", "k", ",", "l"}], " ", "]"}], " ", "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"bc197698-6878-4d29-a591-1010468b3c6e"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"99bbbbd8-9cee-4e81-8e02-1ee4ccb1d0a1"]
}], "Text",ExpressionUUID->"981869f5-2d3f-4637-a679-20f75ebd0f53"],

Cell[TextData[{
 "In terms of the connection coefficients ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubsuperscriptBox["\[CapitalGamma]", 
     StyleBox[
      RowBox[{"i", "j"}], "TI"], 
     StyleBox["k", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "6020b42e-310e-4543-807a-f08d4b37f853"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1ad5c2eb-1654-42e1-b07f-7b759ab3390c"],
 ", we have ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["R", "TI"], 
      StyleBox[
       RowBox[{"i", "j", "k", "l"}], "TI"]], "\[LongEqual]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["i", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "l"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["j", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "l"}], "TI"], 
        StyleBox["p", "TI"]], "+", 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "l"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "r"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"i", "l"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"j", "r"}], "TI"], 
        StyleBox["p", "TI"]], "-", 
       SubsuperscriptBox[
        StyleBox["c", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"], 
        StyleBox["r", "TI"]], 
       SubsuperscriptBox["\[CapitalGamma]", 
        StyleBox[
         RowBox[{"r", "l"}], "TI"], 
        StyleBox["p", "TI"]]}], ")"}], 
     SubscriptBox[
      StyleBox["g", "TI"], 
      StyleBox[
       RowBox[{"p", "k"}], "TI"]], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"f2fdc593-54fd-4c25-bafb-6970d385dd3c"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "8782f028-f61d-47d2-b28c-17b11f74b73a"],
 " Hence Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"Rm", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "daf65f6d-d47e-4b33-b8aa-01f8975a1023"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4d24802e-4f83-4cdb-bbe4-9c8143f9393e"],
 " is as follows:"
}], "Text",ExpressionUUID->"83514a21-59d7-421e-9113-193719c4b576"],

Cell["\<\

Rm=Table[
(
frameD[i,Connection[[j,l,k]]] - frameD[j,Connection[[i,l,k]]] +
Sum[
Connection[[j,l,r]]*Connection[[i,r,k]]
,{r,1,4}
]
-Sum[
Connection[[i,l,r]]*Connection[[j,r,k]]
,{r,1,4}]
-Sum[
c[[i,j,r]]*Connection[[r,l,k]]
,{r,1,4}
]
)*metric[[k,k]]
,{i,1,4},{j,1,4},{k,1,4},{l,1,4}
];\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"f9eb030a-6823-4d6f-8e00-239a69b1f077"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Differential Operators and Curvature Expansions", "Chapter",ExpressionUUID->"d61a12ba-8864-4d8f-a677-c2f7f6823502"],

Cell[TextData[{
 "This section contains code for some differential operators that appear in \
the curvature expansion and the Morse-Bott formula. We begin with the \
covariant derivatives of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"693657da-20ab-47a1-9491-f32ff58e031f"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "bc64c7a1-d0da-4df9-be16-57a39470e617"],
 "- and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "3"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fa239d0a-21d8-4063-b0e7-f8cb9865adf8"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a5e47688-906d-446c-a7db-46a27c9ef7eb"],
 "-tensors. For a ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "2"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"fea0ee00-42a8-42ed-a649-25a67cea9c57"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "3bd68b36-7681-49e5-aba3-c23c6d13841a"],
 "-tensor ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1cd71a1a-c78f-4705-a521-9fcb8880b664"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4a7aec77-5b30-4a01-9814-0e6b2e3e5b4e"],
 ", represented by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "03cd3090-573e-40e9-be6a-919a873a71b4"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "a1be275b-0fcc-4bc2-b096-231c03963b82"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"CovD2", "[", "h", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "88954cac-798e-4a3d-bf27-f0a0622275ee"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "d6e8f432-2e0b-4b02-9295-c80bf5e5a82f"],
 " represents the covariant derivative of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["h", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3fc0c344-0cdd-49a0-8053-16108df7759a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "cecfff68-e917-4f12-bc17-cd99f765e8d9"],
 ":"
}], "Text",ExpressionUUID->"309125a6-ef42-49c8-a376-cd94d72673d4"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["h", "TI"], 
     StyleBox[
      RowBox[{"j", "k"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"CovD2", "[", "h", "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"00e60070-5fd7-4778-954a-9efaa29bfb77"],
 "  "
}], "DisplayFormula",ExpressionUUID->"48ef89ee-8a06-4fbf-a7de-1ed9d680e2a8"],

Cell["\<\
CovD2[h_] := 
  Table[
  frameD[i, h[[j, k]]] - 
  Sum[Connection[[i, j, l]]*h[[l, k]]
      + Connection[[i, k, l]]*h[[j, l]], {l, 1, 4}], 
      {i, 1, 4}, {j, 1, 4}, {k, 1, 4}
     ];\
\>", "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"1f1223fb-4e3c-4160-ac40-8ed902a09152"],

Cell[TextData[{
 "For a ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{"0", ",", "3"}], ")"}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"02ca3a00-26cc-407a-ad3f-c245845e4fbb"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "cac01373-07be-4225-8933-87d7d6c2cb7a"],
 "-tensor ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "2a3b503d-0865-4f88-b20e-9b08fe0d96c3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "e2d8948b-0bb1-4a50-bf45-96f2cb79b2e0"],
 ", represented by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "80febc9c-c19a-49b7-941a-795cc2191577"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "25f6b730-7430-4997-9e9f-2de16a011db2"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"CovD3", "[", "A", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "b3017805-946e-4f4e-a89e-a3bb2a0b65fb"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "2f1a755a-6a4a-40ab-8f67-d287f06652ad"],
 " represents the covariant derivative of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "a7f2315a-07ca-42b3-a149-0753ce1fcdc1"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "bc28ab05-b3e5-4354-a00e-d08a9bc697d6"],
 "."
}], "Text",ExpressionUUID->"ceaccb8e-a76d-4921-8c23-c05127b4c76e"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["D", "TI"], 
     StyleBox["i", "TI"]], 
    SubscriptBox[
     StyleBox["A", "TI"], 
     StyleBox[
      RowBox[{"j", "k", "l"}], "TI"]], "\[LongEqual]", 
    StyleBox[
     RowBox[{
      RowBox[{"CovD3", "[", "A", "]"}], "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k", ",", "l"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
  ExpressionUUID->"95869ac2-89a2-4f88-9ec1-2bc21e48dca6"],
 "  "
}], "DisplayFormula",ExpressionUUID->"7e5abd04-ebb7-4301-abaf-b0f73e3605ae"],

Cell["\<\
CovD3[A_] := 
  Table[
  frameD[i, A[[j, k, l]]] - 
    Sum[Connection[[i, j, m]]*A[[m, k, l]]
      + Connection[[i, k, m]]*A[[j, m, l]]
      + Connection[[i, l, m]]*A[[j, k, m]], 
      {m, 1, 4}], {i, 1, 4}, {j,1, 4}, {k, 1, 4}, {l, 1, 4}
     ];\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"0d6d0ec1-b2b8-4c97-b02c-2517101136bb"],

Cell[TextData[{
 "Recall that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"T", "h"}], "TI"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"6ec1783e-69f6-4264-a3d6-00e121002ee8"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "c2a4be24-67e7-4176-86d8-345916f6995a"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"L", "h"}], "TI"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"7ca57a1c-f82a-4b3f-bcb8-6f9d17d30d19"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "1d5f01ca-8045-4a93-9286-882006b5f533"],
 " are given by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      RowBox[{"(", 
       StyleBox[
        RowBox[{"T", "h"}], "TI"], ")"}], 
      StyleBox[
       RowBox[{"i", "j", "k"}], "TI"]], "\[LongEqual]", 
     FractionBox["1", "2"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["i", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"j", "k"}], "TI"]], "+", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["j", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"k", "i"}], "TI"]], "-", 
       SubscriptBox[
        StyleBox["D", "TI"], 
        StyleBox["k", "TI"]], 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox[
         RowBox[{"i", "j"}], "TI"]]}], ")"}], ","}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"1d3fc54a-e74d-4117-99f1-6e02bd460b7a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "68f73709-d9a1-4784-a191-a725a4188fd9"],
 " and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
