Cell[TextData[{
 "Hence the Mathematica definition of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox[
     RowBox[{"c", "[", " ", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "0fc53b3b-fa1f-4878-ad44-10abef51aa81"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "6ac7778d-85c4-47e3-9e08-5e85cf3e92e9"],
 " is as follows:"
}], "Text",ExpressionUUID->"5fe87972-82dd-4f21-bd63-4a0c1b48730a"],

Cell["\<\
ClearAll[c];
c=Table[0,{i,1,4},{j,1,4},{k,1,4}];
c[[1,2,3]]=1/(Sin[\[Theta]]Cos[\[Theta]]);
c[[2,1,3]]=-1/(Sin[\[Theta]]Cos[\[Theta]]);
c[[1,3,2]]=-Cos[\[Theta]]/Sin[\[Theta]];
c[[3,1,2]]=Cos[\[Theta]]/Sin[\[Theta]];
c[[1,4,1]]=Cos[\[Theta]]/Sin[\[Theta]];
c[[4,1,1]]=-Cos[\[Theta]]/Sin[\[Theta]];
c[[2,3,1]]=Sin[\[Theta]]/Cos[\[Theta]];
c[[3,2,1]]=-Sin[\[Theta]]/Cos[\[Theta]];
c[[2,4,2]]=-Sin[\[Theta]]/Cos[\[Theta]];
c[[4,2,2]]=Sin[\[Theta]]/Cos[\[Theta]];\
\>", "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"fba8a8ab-966e-45e7-93e0-644dcb13582d"],

Cell[TextData[{
 "We define ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["cLow",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "ff308aae-43c2-4c4b-ae59-00443fa79edc"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "c88aeebd-7c5f-4f1b-b6cf-e8be5a3b0aa4"],
 " by ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     StyleBox["g", "TI"], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"[", 
        RowBox[{
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["i", "TI"]], ",", 
         SubscriptBox[
          StyleBox["m", "TI"], 
          StyleBox["j", "TI"]]}], "]"}], ",", 
       SubscriptBox[
        StyleBox["m", "TI"], 
        StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
     StyleBox[
      RowBox[{"cLow", "[", " ", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j", ",", "k"}], "]"}], " ", "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"1c7caeb5-b752-4af1-a100-7f0c831935a4"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"b72cd0b5-3972-4cfa-b805-14557e48868b"]
}], "Text",ExpressionUUID->"2040113c-52b3-434e-a584-9e78c190eb81"],

Cell["\<\
cLow=Table[c[[i,j,k]]*metric[[k,k]],{i,1,4},{j,1,4},{k,1,4}];\
\>", "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"8ad158f7-c1e0-4155-bd88-904bcedb2535"],

Cell[TextData[{
 "Next, we define the directional derivative of a scalar function ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "caa1530c-3272-4a61-a9e0-b23800e9f5a8"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4c43f5de-f66c-4c5b-97cd-f075941eb578"],
 " along the direction ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["m", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "dae6268d-5b29-48b0-b708-9101d613000a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "800843c5-bdfb-4d90-ada3-fc406c7fe381"],
 ". All the quantities to which we apply directional derivatives are \
functions of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox["\[Theta]", TraditionalForm]], "InlineFormula",ExpressionUUID->
   "3be9d6a4-fea6-45f2-9cb5-462682ad8141"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "3cd50b51-7f95-40a2-9734-fbddd8927b2e"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "1"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"180d2e95-1e0c-4aef-a9b6-e1ede82ce0b2"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "153f1288-b28a-45dc-93da-5175c86eb8a8"],
 ", ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "2"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d35136e6-e4ea-4a6a-9b59-504c037f4386"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "ca4e304a-5bc0-443d-9f5f-75c2b39cb613"],
 ", and ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], "3"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"3473f76d-5d87-4580-a46b-05ee96c9457e"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "4aa16de7-3250-4e0b-a934-3bcd650a960c"],
 ". Let ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "950fdb91-8cc6-42c0-8567-2f2258e08cc0"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "60bb949e-1320-4399-8eea-a5f0076ee7b3"],
 " be a scalar function, represented as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["A",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "837f527e-4392-418d-857c-9fb91a7aa0c2"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "d1cac13f-72ff-4056-9fd4-162fd7d10818"],
 " in Mathematica. We define ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    StyleBox["frameD",
     FontSlant->"Plain"], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "9f3b7de9-ba59-4039-ae45-c9be7544ba24"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "fa500b76-e2ff-40e1-9b05-d9c56d7f9428"],
 " such that ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["m", "TI"], 
      StyleBox["i", "TI"]], 
     StyleBox["A", "TI"], "\[LongEqual]", 
     StyleBox[
      RowBox[{"frameD", "[", 
       RowBox[{"i", ",", "A"}], "]"}],
      FontSlant->"Plain"], "."}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"e2e5e8be-2eee-4409-81b9-e23e9915687a"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "e962231f-d59b-43f7-a311-49dcb5be7103"],
 " Using ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["E", "TI"], 
      StyleBox["i", "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["j", "TI"]], "\[LongEqual]", 
     SubscriptBox["\[Epsilon]", 
      StyleBox[
       RowBox[{"i", "j", "k"}], "TI"]], 
     SubscriptBox[
      StyleBox["q", "TI"], 
      StyleBox["k", "TI"]], ","}], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"d0609b79-d2dd-49ba-9072-1f06a79439b0"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "9e397866-8d2d-4a59-acc4-1e5244fc6e00"],
 " and expressing the components of ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    SubscriptBox[
     StyleBox["q", "TI"], 
     StyleBox["i", "TI"]], TraditionalForm]], "InlineFormula",ExpressionUUID->
   "1e4b354a-c8e8-45f6-8faa-617fe5478b08"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "0a7375ee-e199-492c-b53b-86b0c3a61470"],
 " as ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "x"}], "TI"]], ",", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "y"}], "TI"]], ",", 
      SubscriptBox[
       StyleBox["q", "TI"], 
       StyleBox[
        RowBox[{"i", "z"}], "TI"]]}], ")"}], TraditionalForm]], 
   "InlineFormula",ExpressionUUID->"c18e5201-a51a-4eba-8b3e-9afd033ea904"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "866a3c02-dd3a-4139-bdb0-037903ca35fd"],
 ", we have"
}], "Text",ExpressionUUID->"50444036-6f10-445e-b0f8-581d23adaf55"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[Cell[BoxData[
    FormBox[GridBox[{
       {Cell[TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           SubscriptBox[
            StyleBox["m", "TI"], "1"], 
           StyleBox["A", "TI"], "\[LongEqual]"}]], "InlineFormula",
          ExpressionUUID->"04e77994-a2bf-48ee-b82d-be632f635963"],
         " "
        }],ExpressionUUID->"0247ab97-e325-40d1-9f9a-0cda77e13624"], Cell[
        TextData[{
         " ",
         Cell[BoxData[
          RowBox[{
           FractionBox["1", "sin\[Theta]"], 
           RowBox[{"(", 
            RowBox[{
             UnderscriptBox["\[Sum]", 
              RowBox[{
               RowBox[{"*", "\[LongEqual]"}], 
               StyleBox["x", "TI"], ",", 
               StyleBox["y", "TI"], ",", 
               StyleBox["z", "TI"]}],
              LimitsPositioning->True], 
             SubscriptBox[
              StyleBox["q", "TI"], 
