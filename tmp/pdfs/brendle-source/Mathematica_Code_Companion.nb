 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["C", "TI"], 
    SubscriptBox[
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["I",
         FontSlant->"Plain"]], ",", 
       SubscriptBox[
        StyleBox["h", "TI"], 
        StyleBox["II",
