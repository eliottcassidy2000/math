              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["i", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "-", 
            SubscriptBox[
             StyleBox["m", "TI"], 
