             RowBox[{"4", "-"}], 
             SuperscriptBox["cos", "2"], 
             RowBox[{"(", 
              RowBox[{"2", "\[Theta]"}], ")"}]}]], 
           SubsuperscriptBox[
            StyleBox["K", "TI"], 
            SubscriptBox[
             StyleBox["e", "TI"], 
             StyleBox["x", "TI"]], "\[Flat]"], "\[CircleDot]", 
           SubsuperscriptBox[
            StyleBox["K", "TI"], 
            SubscriptBox[
             StyleBox["e", "TI"], 
             StyleBox["z", "TI"]], "\[Flat]"], "."}]], "InlineFormula",
          ExpressionUUID->"6b3748f7-4fb6-4c9e-a517-86f527c4547b"],
         " "
        }],ExpressionUUID->"2fe679c1-6025-4b1e-8876-2ebfafbd0594"]}
      }], TraditionalForm]],ExpressionUUID->
    "1d4d4f86-e1e3-4360-bac1-16977774919e"], TraditionalForm]], 
  "InlineFormula",ExpressionUUID->"8cdc5384-f4fd-4e15-a954-ba08050dc566"],
 "  "
}], "DisplayFormula",ExpressionUUID->"a82d8bfb-bf67-447c-93fa-a5d493d3c0eb"],

