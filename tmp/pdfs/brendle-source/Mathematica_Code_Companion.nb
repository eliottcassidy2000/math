    SubscriptBox["\[CapitalSigma]", "+"], TraditionalForm]], "InlineFormula",
   ExpressionUUID->"5c85d687-e613-41e8-b68b-49df8d429fe3"],
  "  "
 }], "DisplayFormula",ExpressionUUID->
  "8bb6b9b6-0e28-4ef2-8bb7-6094aab6d989"],
 ", and check that under the above parametrization, we have ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[
    RowBox[{
     SubscriptBox[
      StyleBox["A", "TI"], "3"], "\[LongEqual]", 
     FractionBox[
      RowBox[{"cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Theta]"}], ")"}], "cos", 
       RowBox[{"(", 
        RowBox[{"2", "\[Phi]"}], ")"}]}], 
      RowBox[{"3", 
       RowBox[{"(", 
        RowBox[{"7", "-", 
         RowBox[{"cos", 
          RowBox[{"(", 
           RowBox[{"4", "\[Theta]"}], ")"}]}]}], ")"}]}]], "."}], 
    TraditionalForm]], "InlineFormula",ExpressionUUID->
   "d8563522-a466-4678-a087-a45da49017ab"],
  "  "
 }], "DisplayFormula",ExpressionUUID->"585d74d4-963c-448f-92ed-c3f11adaf202"]
}], "Text",ExpressionUUID->"7c8017ac-e610-4ffc-b3d2-d1d5e7e2ef6a"],

