Cell["\<\
rb=P1[L[hb]]//Simplify;
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
Vbd=P0[L[hbd]]+P0[Q[hb,hd]]+1/2rb.zd;
Vbd=FullSimplify[Vbd,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"f0356f3f-1b17-4b7d-948b-4a80c7e48e80"],

