Cell["\<\
rc=P1[L[hc]]//Simplify;
rd=P1[L[hd]]//Simplify;
zd=-Inverse[H].rd//Simplify;
Vcd=P0[L[hcd]]+P0[Q[hc,hd]]+1/2rc.zd;
Vcd=FullSimplify[Vcd,0<\[Theta]<\[Pi]/2];\
\>", "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"1eee2a73-e9e8-4cc6-a90b-6679fcf7510d"],

