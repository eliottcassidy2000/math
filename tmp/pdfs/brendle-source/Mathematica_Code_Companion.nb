Cell["\<\
Q[h1_, h2_] := Module[{T1,T2},
T1=T[h1];
T2=T[h2];
Table[
Sum[
inversemetric[[m, m]]*(
      T1[[j, k, m]]*T2[[i, l, m]]/2 -
       T1[[i, k, m]]*T2[[j, l, m]]/2 +
       T2[[j, k, m]]*T1[[i, l, m]]/2 -
       T2[[i, k, m]]*T1[[j, l, m]]/2), 
      {m, 1, 4}
      ], 
      {i, 1, 4}, {j, 1, 4}, {k, 1, 4}, {l, 1, 4}
      ]
]      \
\>", "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"2b5b548a-181b-4bd0-8b62-c0b9fac345e7"],

