 "  "
}], "DisplayFormula",ExpressionUUID->"8a8edce1-9be8-4898-9b23-921ff98e8b25"],

Cell[TextData[{
 "Recall the Koszul formula ",
 Cell[TextData[{
  Cell[BoxData[
   FormBox[Cell[BoxData[
     FormBox[GridBox[{
        {Cell[TextData[{
          " ",
          Cell[BoxData[
           RowBox[{
            StyleBox["g", "TI"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox[
               StyleBox["D", "TI"], 
               SubscriptBox[
                StyleBox["m", "TI"], 
                StyleBox["i", "TI"]]], 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["j", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "\[LongEqual]", 
            FractionBox["1", "2"], "("}]], "InlineFormula",ExpressionUUID->
           "17d067d0-1d38-44cb-b409-f344dc770d58"],
          " "
         }],ExpressionUUID->"8f1b3b52-d7cf-4ab1-8957-d49207a03340"], Cell[
         TextData[{
          " ",
          Cell[BoxData[
           RowBox[{
            SubscriptBox[
             StyleBox["m", "TI"], 
             StyleBox["i", "TI"]], 
            StyleBox["g", "TI"], 
            RowBox[{"(", 
             RowBox[{
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["j", "TI"]], ",", 
              SubscriptBox[
               StyleBox["m", "TI"], 
               StyleBox["k", "TI"]]}], ")"}], "+", 
