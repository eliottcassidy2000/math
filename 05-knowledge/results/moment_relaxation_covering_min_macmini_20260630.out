    T_2 = +1.42294  <- +pair correlations (2nd moment / HYP-3571 / S75)
    T_3 = -2.99017
    T_4 = +5.36624
    T_5 = -7.31323
    T_6 = +7.41514
    T_7 = -5.52063
  level-1 value 1-|S|*2r = -0.9692  (USELESS: <0; the finite union bound cannot certify)

