THM-2992 signed quartic edge block-parity decoder
symbolic_ring=Q[p,r,u,s,h,T]/(s^2-u,S(u)) with h=q/s
factor_error=(-h**2 + p**2 + 2*p*u - 4*r + u**2)/4=S(u)/(4u)
delta_plus=-2*h - 2*p - u
delta_minus=2*h - 2*p - u
delta_product=-4*p*u + 16*r - 3*u**2
block_resultant=p**2 + 4*p*u - 4*r + 3*u**2=S'(u)
quartic_discriminant=delta_plus*delta_minus*S'(u)^2
signed_edge_reversal=block_label_swap
quotient_transpositions=[(0, 2, 1), (1, 0, 2), (2, 1, 0)]
quotient_lifts=12 transpositions=6 four_cycles=6
fixed_block_records=[((0, 2, 1), 0, ((0, 1), (2, 3))), ((1, 0, 2), 2, ((0, 3), (1, 2))), ((2, 1, 0), 1, ((0, 2), (1, 3)))]
matching_direction_v4_differences=3
identity_deltas=(4, -8) parity=(0,0)
transposition_deltas=(4*t, 4) parity=(1,0) resultant=(t - 9)*(t - 1)
double_transposition_deltas=(4*t, 8*t) parity=(1,1)
four_cycle_eisenstein=T^4+tT+t disc=t^3*(256-27t)
four_cycle_fixed_matching_vK(u)=1 signed_edge_not_in_K=1
after_signed_edge_extension=(vL(u),vL(q/s),block_parities)=(2,1,(1,1))
