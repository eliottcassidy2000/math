    K33_incidence        5
    product_edges        5
    perfect_abundancy    3
    minor_closure        2
    kuratowski_core      1
    raw_edge_density     0
  directed_3_cycles=2
    cycle K33_incidence -> product_edges -> farey_level -> K33_incidence
    cycle unit_excess_chain -> product_edges -> farey_level -> unit_excess_chain
  SCCs:
