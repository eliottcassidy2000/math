  unit_positive: score_hist=((0, 1), (2, 2), (3, 2)), c3=2, scc=(4, 1), H=5, redei_path_states={L:2, S:1, U:1}
  unit_negative: score_hist=((0, 1), (1, 1), (2, 1), (3, 1), (4, 1)), c3=0, scc=(1, 1, 1, 1, 1), H=1, redei_path_states={S:1, U:3}

