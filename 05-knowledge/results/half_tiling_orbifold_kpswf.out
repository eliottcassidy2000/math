[a] MERGED TILING COUNT  = #rho-orbits = (2^m + 2^half)/2
  n    m  half        2^m   2^half   (2^m+2^half)/2  V_merged
  3    1     1          2        2                2         2
  4    3     2          8        4                6         3
  5    6     4         64       16               40        10
  6   10     6       1024       64              544        34
  7   15     9      32768      512            16640       272
