    (1,5,3): diffs=(+4,-2,-2) = [2p=4, p=2, p=2]
    (2,5,3): diffs=(+3,-2,-1) = [p=3, p=2, 1]
    (2,5,4): diffs=(+3,-1,-2) = [p=3, 1, p=2]

