    (1,6,3): diffs=(+5,-3,-2) = [p=5, p=3, p=2]
    (1,5,4): diffs=(+4,-1,-3) = [2p=4, 1, p=3]
    (1,6,4): diffs=(+5,-2,-3) = [p=5, p=2, p=3]
