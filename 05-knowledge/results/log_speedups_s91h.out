      5 |    11.77087179 |    11.33890024 |   FAIL | 0.0007ms | 0.0003ms |    2.3x
      7 |    12.26500217 |    11.34328232 |   FAIL | 0.0007ms | 0.0003ms |    2.3x
     10 |    13.00887647 |    11.39772383 |   FAIL | 0.0006ms | 0.0003ms |    2.1x
     42 |    19.00151603 |    12.13468007 |   FAIL | 0.0007ms | 0.0003ms |    2.3x
    100 |    26.20860496 |    13.00887647 |   FAIL | 0.0006ms | 0.0003ms |    2.1x
   1000 |    77.12364880 |    17.34252219 |   FAIL | 0.0006ms | 0.0003ms |    1.9x
