  m=2: E[P^m]=!=0(6), a_max=2, DOMINANT a=2 (=top), |top|/|total|=0.667
  m=3: E[P^m]=!=0(114), a_max=4, DOMINANT a=4 (=top), |top|/|total|=0.632
  m=4: E[P^m]=!=0(228), a_max=4, DOMINANT a=4 (=top), |top|/|total|=0.632
  m=5: E[P^m]=!=0(23160), a_max=6, DOMINANT a=6 (=top), |top|/|total|=0.622
  m=6: E[P^m]=!=0(1002720), a_max=8, DOMINANT a=8 (=top), |top|/|total|=0.603
  m=7: E[P^m]=!=0(6856920), a_max=8, DOMINANT a=8 (=top), |top|/|total|=0.617
  m=8: E[P^m]=!=0(995858640), a_max=10, DOMINANT a=10 (=top), |top|/|total|=0.612

=== CASE3: z^2 + (1+u)w  [one-sided top, non-const charge-1, genuinely two-sided] ===
