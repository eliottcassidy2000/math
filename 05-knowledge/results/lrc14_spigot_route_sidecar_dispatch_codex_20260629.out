axes=('I',) target=private_firewall_bit fibers=3 max_fiber=123 mixed=0/0 pure=True
axes=('Q',) target=private_firewall_bit fibers=3 max_fiber=123 mixed=0/0 pure=True
axes=('I',) target=private_dead_status fibers=3 max_fiber=123 mixed=0/0 pure=True
axes=('Q',) target=private_dead_status fibers=3 max_fiber=123 mixed=0/0 pure=True
