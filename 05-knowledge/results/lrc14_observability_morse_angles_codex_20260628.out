DISCRETE MORSE / LYAPUNOV DESCENT PACKET
  coordinates=tope_boundary_depth, toeplitz_deficit_order, green_resistance_excess, lag_transport_cost, unit_equioscillation_defect, index_equality_defect, gauss_sum_word_depth, bu_forcing_gap_status, root_collision_depth, odd_negative_debt, chart_change_depth, hensel_unit_failure, state_lift_distance
