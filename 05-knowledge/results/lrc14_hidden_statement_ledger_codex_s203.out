[1] Micro-statement ledger
  MS01 owner_essential_boundary_h1 (HYP-3034/HYP-3030/HYP-3025)
    role=front_gate
    statement=Zero-open is not just beta1=1; on the tested collision surface it is an owner-essential closed danger-arc H1 representative.
    evidence=AP and GW are the only closed-H1 rows; each has a 58-edge representative and deleting any owner speed kills H1.
    keeps=status,topology,owner,boundary,deletion
    destroys=route,exact_magnitude,runner_order
    past_threads=path_homology,deletion_persistence,arc_cech
  MS02 coarse_status_gate_before_routes (HYP-3024/HYP-3028/HYP-3030/HYP-3034)
    role=ordering_rule
    statement=The coarse ET+Henselian gate is a status theorem before it is a route theorem.
    evidence=Full-bank coarse ET+unit fibers have 0 mixed boundary/open fibers; their route-mixed survivors are all strict-open.
