    abundance = sigma - 2n = 4
    phi(n) = 4
    Match: True
    n/6 = 2.0
    sigma/n = 7/3 = 2.333333
    phi/n = 1/3 = 0.333333
    abundance/n = 1/3 = 0.333333

  n =         42 = 2 * 3 * 7
