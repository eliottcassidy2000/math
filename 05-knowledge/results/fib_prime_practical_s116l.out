======================================================================
TOOL 3: FIBONACCI ENTRY POINT FACTORING
======================================================================

Theory: alpha(n) = min k with n | F_k. Then gcd(n, F_d)
for d | alpha(n) often reveals factors of n.

n = 21:
  alpha(21) = 8  (F_8 = 0 mod 21)
  Divisors of alpha: [1, 2, 4, 8]
    gcd(21, F_4) = gcd(21, 3) = 3 <-- FACTOR!
    gcd(21, F_8) = 21 (= n, trivial)
  Factorization: 21 = 3 x 7

n = 42:
  alpha(42) = 24  (F_24 = 0 mod 42)
  Divisors of alpha: [1, 2, 3, 4, 6, 8, 12, 24]
    gcd(42, F_3) = gcd(42, 2) = 2 <-- FACTOR!
    gcd(42, F_4) = gcd(42, 3) = 3 <-- FACTOR!
    gcd(42, F_6) = gcd(42, 8) = 2 <-- FACTOR!
    gcd(42, F_8) = gcd(42, 21) = 21 <-- FACTOR!
    gcd(42, F_12) = gcd(42, 144) = 6 <-- FACTOR!
    gcd(42, F_24) = 42 (= n, trivial)
  Factorization: 42 = 2 x 3 x 7

n = 91:
  alpha(91) = 56  (F_56 = 0 mod 91)
  Divisors of alpha: [1, 2, 4, 7, 8, 14, 28, 56]
    gcd(91, F_7) = gcd(91, 13) = 13 <-- FACTOR!
    gcd(91, F_8) = gcd(91, 21) = 7 <-- FACTOR!
    gcd(91, F_14) = gcd(91, 377) = 13 <-- FACTOR!
    gcd(91, F_28) = gcd(91, 317811) = 13 <-- FACTOR!
    gcd(91, F_56) = 91 (= n, trivial)
  Factorization: 91 = 7 x 13

n = 143:
  alpha(143) = 70  (F_70 = 0 mod 143)
  Divisors of alpha: [1, 2, 5, 7, 10, 14, 35, 70]
    gcd(143, F_7) = gcd(143, 13) = 13 <-- FACTOR!
    gcd(143, F_10) = gcd(143, 55) = 11 <-- FACTOR!
    gcd(143, F_14) = gcd(143, 377) = 13 <-- FACTOR!
    gcd(143, F_35) = gcd(143, 9227465) = 13 <-- FACTOR!
    gcd(143, F_70) = 143 (= n, trivial)
  Factorization: 143 = 11 x 13

n = 6174:
  alpha(6174) = 1176  (F_1176 = 0 mod 6174)
  Divisors of alpha: [1, 2, 3, 4, 6, 7, 8, 12, 14, 21, 24, 28, 42, 49, 56, 84, 98, 147, 168, 196, 294, 392, 588, 1176]
    gcd(6174, F_3) = gcd(6174, 2) = 2 <-- FACTOR!
    gcd(6174, F_4) = gcd(6174, 3) = 3 <-- FACTOR!
    gcd(6174, F_6) = gcd(6174, 8) = 2 <-- FACTOR!
    gcd(6174, F_8) = gcd(6174, 21) = 21 <-- FACTOR!
    gcd(6174, F_12) = gcd(6174, 144) = 18 <-- FACTOR!
    gcd(6174, F_21) = gcd(6174, 10946) = 2 <-- FACTOR!
    gcd(6174, F_24) = gcd(6174, 46368) = 126 <-- FACTOR!
    gcd(6174, F_28) = gcd(6174, 317811) = 3 <-- FACTOR!
    gcd(6174, F_42) = gcd(6174, 267914296) = 2 <-- FACTOR!
    gcd(6174, F_56) = gcd(6174, 225851433717) = 147 <-- FACTOR!
    gcd(6174, F_84) = gcd(6174, ...) = 18 <-- FACTOR!
    gcd(6174, F_147) = gcd(6174, ...) = 2 <-- FACTOR!
    gcd(6174, F_168) = gcd(6174, ...) = 882 <-- FACTOR!
    gcd(6174, F_196) = gcd(6174, ...) = 3 <-- FACTOR!
    gcd(6174, F_294) = gcd(6174, ...) = 2 <-- FACTOR!
    gcd(6174, F_392) = gcd(6174, ...) = 1029 <-- FACTOR!
    gcd(6174, F_588) = gcd(6174, ...) = 18 <-- FACTOR!
    gcd(6174, F_1176) = 6174 (= n, trivial)
  Factorization: 6174 = 2 x 3 x 3 x 7 x 7 x 7

