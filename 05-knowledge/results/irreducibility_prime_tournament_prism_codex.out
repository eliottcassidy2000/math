[5] Real-factor recombination as subset-sum over trace atoms
    Toy polynomial: (x^4+1)(x^2+1).  Over R, x^4+1 splits into
    two quadratic atoms with traces +/-sqrt(2); integer factors are
    recovered by recombining trace-compatible subsets.
    subset=('A_plus',)                  degree=2 trace=sqrt(2)  traceZ=False integer_factor=False labels=('x^4+1',)
    subset=('A_minus',)                 degree=2 trace=-sqrt(2) traceZ=False integer_factor=False labels=('x^4+1',)
    subset=('A_plus', 'A_minus')        degree=4 trace=0        traceZ=True integer_factor=True labels=('x^4+1',)
    subset=('B_unit',)                  degree=2 trace=0        traceZ=True integer_factor=True labels=('x^2+1',)
    subset=('A_plus', 'B_unit')         degree=4 trace=sqrt(2)  traceZ=False integer_factor=False labels=('x^2+1', 'x^4+1')
    subset=('A_minus', 'B_unit')        degree=4 trace=-sqrt(2) traceZ=False integer_factor=False labels=('x^2+1', 'x^4+1')
    subset=('A_plus', 'A_minus', 'B_unit') degree=6 trace=0        traceZ=True integer_factor=True labels=('x^2+1', 'x^4+1')

