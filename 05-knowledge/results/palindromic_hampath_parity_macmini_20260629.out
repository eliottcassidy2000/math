================================================================================
Palindromic Hamiltonian path parity -- the odd index (mac-mini-S6)
================================================================================

[Paley tournaments T_p, p=3 mod4, self-converse via phi(x) = -x mod p]
  Paley_3 (n=3): H(T)=3 (ODD), rho:HP->HP=True, involution=True, #palindromic=1 (ODD), H==#palin mod2: True
      example palindromic path: (2, 0, 1)  (rho = (2, 0, 1))
  Paley_7 (n=7): H(T)=189 (ODD), rho:HP->HP=True, involution=True, #palindromic=9 (ODD), H==#palin mod2: True
      example palindromic path: (1, 2, 3, 0, 4, 5, 6)  (rho = (1, 2, 3, 0, 4, 5, 6))
  Paley_11 (n=11): H(T)=95095 (ODD), rho:HP->HP=True, involution=True, #palindromic=185 (ODD), H==#palin mod2: True
      example palindromic path: (1, 2, 3, 6, 7, 0, 4, 5, 8, 9, 10)  (rho = (1, 2, 3, 6, 7, 0, 4, 5, 8, 9, 10))

