  VERIFYING THE ROYLE ET AL. IDENTITY
========================================================================

  FORMULA: #Graphs = (1/n!) sum_g 2^{c(g_E)}
           #Tourn  = (1/n!) sum_{|g| odd} 2^{c(g_E)}
           #Odd    = (1/n!) sum_{|g| even} 2^{c(g_E)}
           #Even   = #Graphs - #Odd = #Tourn

  n=3: #Graphs=4, #Tourn=2, #Odd=2, #Even=2
       A000088=4, A000568=2, Even=Tourn? True

  n=4: #Graphs=11, #Tourn=4, #Odd=7, #Even=4
