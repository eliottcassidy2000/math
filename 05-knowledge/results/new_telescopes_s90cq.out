  N=    18, spf= 2, step=   9, factor=1.5000
  N=    27, spf= 3, step=   9, factor=1.3333
  N=    36, spf= 2, step=  18, factor=1.5000
  N=    54, spf= 2, step=  27, factor=1.5000
  N=    81, spf= 3, step=  27, factor=1.3333
