  ERDOS [label="Erdos ternary problem\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="2^n has a ternary digit 2 for every n > 8"];
  MAHLER [label="Mahler 3/2 Z-numbers\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="no xi > 0 with 0 <= {xi (3/2)^n} < 1/2 for all n"];
  GMAH [label="generalized Z(p/q, I)\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="no xi > 0 with xi (p/q)^n in Z + I for all n (Mahler/FLP/Bugeaud/AFS family)"];
