  LEHMER [label="Lehmer's problem\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="Mahler measures of non-cyclotomic integer polynomials are bounded away from 1"];
  GRACE [label="graceful tree\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="every tree is graceful (Pi^0_1)"];
