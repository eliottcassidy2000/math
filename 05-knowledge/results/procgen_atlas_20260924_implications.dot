  GTRANS -> COL [style=solid, color="#1a8a1a", tooltip="CITED: Collatz holds iff G_C acts transitively on N minus 0(6) (Kohl, J. Group Theory 20 (2017) Prop. 1.2 [P])", label="<=> cited", dir=both, penwidth=3.2];
  RCWA -> GTRANS [style=solid, color="#1f4fbf", tooltip="CITED: RCWA reformulations of 3x+1 (class-transposition groups; sigma_T on Z^2) (Kohl 2017; thesis 3.13 [P])", label="~ cited", arrowhead=none, constraint=false];
  BAKER -> PERMF [style=solid, color="#1f4fbf", tooltip="CITED: finitely many m-cycles of Collatz-type permutations; none for m <= 2 besides the known ones (Simons 2022 [P]; Keller [P via Kohl])", label="~ cited", arrowhead=none, constraint=false];
  ERDOS -> Q2 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: Q2 needs low 3-adic digits along dynamically chosen K; every 3-adic-window Erdos statement is FALSE (transversality foundry sec. 3)", label="x no known link", arrowhead=none, constraint=false];
  ERDOS -> T1 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: different map and place (transversality foundry sec. 5)", label="x no known link", arrowhead=none, constraint=false];
  FURST -> T1 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: a measure statement: DEFECT-blind for every every-orbit target (transversality foundry sec. 5)", label="x no known link", arrowhead=none, constraint=false];
  NORMAL -> NC [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: cycle bounds use the continued fraction / irrationality exponent of log_2 3, not its digits (this note)", label="x no known link", arrowhead=none, constraint=false];
  LITTLE -> Q2 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: no statement of either form controls the carry/landing conditions (this note)", label="x no known link", arrowhead=none, constraint=false];
  PSCH -> PC [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: Bernstein numbers are not exponential-type values (cube-theta note sec. 0)", label="x no known link", arrowhead=none, constraint=false];
  TWIN -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_2 statement; Kurtz-Simon reduction to an 'all orbits reach 1' statement of a generalized Collatz map (Kurtz-Simon 2007 [P])", label="~ cited", arrowhead=none, constraint=false];
  GOLD -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_1: non-halting of an explicit program; Conway's FRACTRAN encoding (Conway 1972/1987 [R])", label="~ cited", arrowhead=none, constraint=false];
  LEG -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_1, as for Goldbach (Conway [R])", label="~ cited", arrowhead=none, constraint=false];
  RH -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_1 via Lagarias's elementary criterion (sigma(n) <= H_n + exp(H_n) log H_n) (Lagarias 2002 Thm 1.1 [P]; Conway [R])", label="~ cited", arrowhead=none, constraint=false];
  GRACE -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_1 (finite search per tree) (Conway [R])", label="~ cited", arrowhead=none, constraint=false];
  LRC -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: Pi^0_1 (Tao 2018: finite check for each n) (Tao 2018 Thm 1.3, Cor. 1.4 [P]; Conway [R])", label="~ cited", arrowhead=none, constraint=false];
  UNDEC -> GCOLL [style=solid, color="#1f4fbf", tooltip="CITED: universality of generalized Collatz maps (Conway 1972; Kurtz-Simon 2007)", label="~ cited", arrowhead=none, constraint=false];
  GCOLL -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: the encodings use other maps; the 3x+1 map itself is not known to be universal or undecidable (Kurtz-Simon; GGM 2025 remark)", label="x no known link", arrowhead=none, constraint=false];
  RH -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: trunk/Iwasawa coordinate only; zeta_3 zero-free; no bridge (trunk/RH note)", label="x no known link", arrowhead=none, constraint=false];
  LEHMER -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: no shared object (this note)", label="x no known link", arrowhead=none, constraint=false];
  LRC -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: analogy only (S596 two-block question) (bridges note)", label="x no known link", arrowhead=none, constraint=false];
  KL -> COL [style=dashed, color="#808080", tooltip="OPEN: stochastic models predict Collatz (and 5x+1 divergence); transfer to the map is unproved (Kontorovich-Lagarias 2010 [P])", label="open"];
  KL -> DIV5 [style=dashed, color="#808080", tooltip="OPEN: the 5x+1 model has positive drift (Kontorovich-Lagarias 2010 [P])", label="open"];
  PAIR -> KL [style=solid, color="#000000", tooltip="PROVED: AM factor (q+1)/4 = 1 iff q = 3; the model drift log(sqrt3/2) is the AM-GM gap (this note F2; bridges note)", label="~ proved", arrowhead=none, constraint=false];
  ERG2 -> DOOB [style=solid, color="#1f4fbf", tooltip="CITED: Haar-independence of parity bits makes M_j = 3^a_j/2^j a martingale (Lagarias 1985 Thm K [P])", label="~ cited", arrowhead=none, constraint=false];
  DOOB -> TERRAS [style=solid, color="#1a8a1a", tooltip="PROVED: M_j -> 0 a.s., so tau < infinity a.s., so the stopping density is 1 (this note F4 (Terras 1976 [R] first))", label="new proved", penwidth=3.2];
  DOOB -> DDOOB [style=solid, color="#000000", tooltip="PROVED: Doob's maximal inequality on the exact finite martingale (this note F3, F5)", label="new proved"];
  PAIR -> DDOOB [style=solid, color="#1a8a1a", tooltip="PROVED: fairness = martingale = Lundberg exponent 1 (Pareto(1) excursion tail) (this note F2, F3)", label="new proved", penwidth=3.2];
  TERRAS -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: density statements are DEFECT-blind (barrier atlas)", label="x no known link", arrowhead=none, constraint=false];
  DDOOB -> T1 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: density statements are DEFECT-blind (barrier atlas)", label="x no known link", arrowhead=none, constraint=false];
  UNDEC -> COL [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: UNIFORM barrier binds uniform methods only (barrier atlas sec. 3)", label="x no known link", arrowhead=none, constraint=false];
  CATAL -> PILLAI [style=solid, color="#1f4fbf", tooltip="CITED: Catalan is the case c = 1 of Pillai's Conj. 1.3 (Mihailescu 2004 [R]; Waldschmidt 2004 Thm 1.2 [P])", label="~ cited", arrowhead=none, constraint=false];
  ABC -> PILLAI [style=dashed, color="#d07000", tooltip="CONDITIONAL: abc implies Pillai's Conj. 2.6: |x^p - y^q| >= C max^(1-1/p-1/q-eps) (Waldschmidt 2004, p. 13 [P])", label="conditional"];
  LW -> PILLAI [style=dashed, color="#d07000", tooltip="CONDITIONAL: Lang-Waldschmidt (Conj. 2.5) implies Conj. 2.6; for 2, 3: |2^a - 3^b| >= 2^a a^(-1-eps) (Waldschmidt 2004, p. 13 [P])", label="conditional"];
  BAKER -> PILLAI [style=solid, color="#1f4fbf", tooltip="CITED: for bases 2, 3: |2^x - 3^y| > 2^x e^(-x/10) (x outside a finite list); 3^x - 2^y = c has at most one solution for |c| > 13; at most two for general a, b (Ellison 1971 Thm 3 [P]; Stroeker-Tijdeman 1982 [R]; Bennett 2001 Thm 1.1 [P])", label="cited"];
  SP -> MAHLER [style=dotted, color="#c00000", tooltip="FALSE: the unrestricted swap principle at Mahler's base 2/3 is FALSE (M-orbit of 1) (this note B5)", label="x new false", arrowhead=none, constraint=false];
  PC -> Q2 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: different quantifier structure (backward reachability, low 3-adic digits) (foundry v4)", label="x no known link", arrowhead=none, constraint=false];
  { rank=same; COL; }
}
