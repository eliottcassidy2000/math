  LS2 [label="Le-Smith Conj. 2\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="every nontrivial E-cycle uses an E-only arrow"];
  LBH [label="Rozier's LBH\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="Lower Bound Hypothesis: n >= j^(-C) 2^((1-H(q/j)) j) for the first j iterates with q odd terms"];
  LBHS [label="LBH slices\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="n >= c_eps 2^((1-eps) j) for parity prefixes with one even term (Rozier) or of shape 1^k 0^l (Prop. R2)"];
  MCYC [label="m-cycle / length bounds\n[PROVED]", shape=box, style="filled,rounded,dashed", fillcolor="#d9f2d9", tooltip="no m-cycle for m <= 91 (Hercher 2023); with Barina's 2^71 and Hercher Cor. 29 every nontrivial cycle has >= 137,528,045,312 odd terms"];
  CYCGR [label="L_min(N) >= N^(1/2-eps)\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="least cycle length grows like the square root of the verification bound"];
