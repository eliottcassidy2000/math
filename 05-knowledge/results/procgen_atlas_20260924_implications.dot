  RCWA -> T1 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: wildness is DRIFT- and SHEET-blind: every surjective non-injective rcwa map (3x-1, 5x+1) is wild (Kohl AAM 2007 Thm 2.9 [P]; this note sec. 8)", label="x no known link", arrowhead=none, constraint=false];
