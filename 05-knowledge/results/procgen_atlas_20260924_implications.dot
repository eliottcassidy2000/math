  ABC [label="abc conjecture\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="Oesterle-Masser; explicit forms (A. Baker 2004) and the n-term conjecture"];
  PILLAI [label="Pillai's conjecture\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="|x^p - y^q| grows; fixed-c finiteness; for bases 2,3 proved (Stroeker-Tijdeman, Bennett)"];
  BAKER [label="Baker / effective linear\nforms\n[PROVED]", shape=ellipse, style="filled", fillcolor="#d9f2d9", tooltip="Baker's theorem; explicit two-log bounds (Laurent-Mignotte-Nesterenko, Rhin); Ellison 1971"];
  LW [label="Lang-Waldschmidt\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="sharp lower bound for linear forms in logarithms; gives irrationality exponent 2 for log_2 3"];
