  DDOOB [label="deterministic Doob\n[PROVED]", shape=hexagon, style="filled", fillcolor="#d9f2d9", tooltip="d{n : max_{j<=k} T^j(n) >= lam n} = P_k(lam) <= 1/lam, with a Pareto(1) tail (Lundberg exponent 1)"];
  PAIR [label="pair-sum fairness\n[PROVED]", shape=hexagon, style="filled", fillcolor="#d9f2d9", tooltip="T(2i-1)+T(2i) = (2i-1)+2i; (3,1) and (3,-1) are the only (q,r) preserving a consecutive pairing"];
  PERM8 [label="orbit of 8 (Collatz 1932)\n[OPEN]", shape=hexagon, style="filled", fillcolor="#f0e6ff", tooltip="under g(3m)=2m, g(3m+1)=4m+1, g(3m+2)=4m+3 the orbit of 8 is infinite"];
  PERMF [label="g has finitely many cycles\n[OPEN]", shape=hexagon, style="filled", fillcolor="#f0e6ff", tooltip="Lagarias's (C4) for Collatz's permutation; 4 positive cycles known (min 1, 2, 4, 44); finitely many of each length (Keller) and of each m (Simons 2022)"];
  KOHLC [label="Kohl: T contracting\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="every integer trajectory enters the 18-point centre {-136,...,2} of the five known cycles (Kohl thesis 3.6)"];
  GTRANS [label="G_C transitive\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="<tau_1(2),4(6), tau_1(3),2(6), tau_2(3),4(6)> acts transitively on N minus 0(6) (Kohl 2017)"];
  GATE [label="shared gate 2^K vs 3^L\n[PROVED]", shape=hexagon, style="filled", fillcolor="#d9f2d9", tooltip="T-cycles: n(2^K-3^L)=B(w)>0; g-cycles: n(3^k-2^K)=D_w signed; both on the convergent clocks of log_2 3"];
