  ABC -> Y3 [style=dotted, color="#b0b0b0", tooltip="NO KNOWN LINK: the n-term abc conjecture is too weak (radical exponent 2n-5 grows) (cube-theta note sec. 4)", label="x no known link", arrowhead=none, constraint=false];
