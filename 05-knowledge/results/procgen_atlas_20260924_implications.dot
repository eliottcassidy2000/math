  COL [label="Collatz conjecture\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="every n >= 1 reaches 1 under T(x)=x/2, (3x+1)/2; verified for n < 2^71 (Barina 2025)"];
  T1 [label="T1: no divergence\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="no positive integer has an unbounded T-orbit; = PC on Z^+ (Bernstein 1994: Z^+ meets Phi(non-EP words) nowhere)"];
  NC [label="NC: no nontrivial cycle\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="no positive T-cycle other than {1,2}; a Pi^0_1 statement"];
  PC [label="PC (Lagarias 1985)\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="Periodicity Conjecture Q_inf(Q_2)=Q_2: every rational in Z_2 has an eventually periodic parity vector"];
  C2 [label="C2 (HYP-9123)\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="no rational has a non-EP parity vector of bounded discrepancy around a supercritical slope"];
  Y3 [label="cube-swap (HYP-9127)\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="sum_k (2^10/3^9)^(k^3) is irrational in Q_2"];
  Q1 [label="E-SCC Q1\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="every n reaches 1 in the relaxed graph E (Le-Smith loosened graph)"];
  Q2 [label="E-SCC Q2\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="1 reaches every m prime to 3 in E; verified below 10^18"];
  XMIN [label="X_min (HYP-9124)\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="no integer m >= 2 lies in the backward exceptional set Bad_inf"];
  CST [label="Terras sigma = tau\n[OPEN]", shape=box, style="filled,bold", fillcolor="#dbe9ff", tooltip="coefficient stopping time conjecture: sigma(n) = tau(n) for n >= 2; verified to 2.8*10^19 (Rozier-Terracol)"];
  TAU [label="tau finite on Z^+\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="every n >= 1 has 3^(a_j(n)) < 2^j for some j (finite coefficient stopping time)"];
  PC3K [label="no divergence for all 3x+k\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="no map (3x+k)/2, x/2 with k = +-1 mod 6 has a divergent integer orbit"];
  SP [label="swap principle SP(2^L/3^a)\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="for 2^L < 3^a, 1 <= a < L, non-EP S: sum_{s in S} (2^L/3^a)^s is irrational in Q_2 (PROVED for 3^a < 2^L; FALSE at a = L, base 2/3)"];
  T1A [label="T1 on block classes A^N\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="no positive integer has a T-parity vector eventually in A^N, A = >=2 blocks of length L and weight a, 3^a > 2^L (supercritical, positive entropy)"];
  T1AS [label="T1 on an adjacent pair\nclass\n[OPEN]", shape=box, style="filled,rounded,dashed", fillcolor="#eef4ff", tooltip="the case A = {B,B'}, R_B' = R_B + 1, 3^a > 2^(L+1): e.g. L=10, a=7, A = {0111101110, 1101100111}"];
  GMAS [label="Z(3^a/2^L,\n[R,R+1]/(3^a-2^L))\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="e.g. no xi > 0 with xi (2187/1024)^j in Z + [4726,4727]/1163 for all j; an interval 1.88 times the FLP length 1/p"];
