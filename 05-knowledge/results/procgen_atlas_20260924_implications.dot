  LITTLE [label="(mixed) Littlewood\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="liminf n ||n a|| ||n b|| = 0; inf n |n|_p ||n a|| = 0"];
  TWIN [label="twin primes\n[OPEN]", shape=ellipse, style="filled", fillcolor="#fff7d6", tooltip="infinitely many p with p+2 prime (Pi^0_2)"];
