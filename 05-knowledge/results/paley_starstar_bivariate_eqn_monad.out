========================================================================
  xyG^2+G-1: [y^j] = [0, x*(x**4 + x**3 + x**2 + x + 2), x**2*(32*x**3 + 20*x**2 + 11*x + 5), x**3*(269*x**2 + 92*x + 20), x**4*(748*x + 101), 594*x**5, 0]
  xG^2+G-1-x: [y^j] = [0, x*(3*x**4 + 3*x**3 + 3*x**2 + 3*x + 1), x**2*(69*x**3 + 38*x**2 + 16*x + 3), x**3*(398*x**2 + 104*x + 13), 3*x**4*(251*x + 23), 421*x**5, 0]
