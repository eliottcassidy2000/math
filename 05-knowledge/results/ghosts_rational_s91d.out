      2/5 |      2/5 |   -17/25 | -118/125 |  -47/625 | 2762/3125 |   1.159279
      1/5 |      1/5 |   -23/25 |  -71/125 |  433/625 | 2641/3125 |   1.369438
     -1/5 |     -1/5 |   -23/25 |   71/125 |  433/625 | -2641/3125 |   1.772154
