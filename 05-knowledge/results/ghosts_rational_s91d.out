     1 |      -1.600000 |       -1
     2 |       0.200000 |       -1
     3 |       0.688000 |       -3
     4 |      -0.278400 |       -4
     5 |      -0.038400 |       -4
     6 |       0.030848 |       -6
     7 |      -0.000973 |       -7
     8 |      -0.001196 |       -8
     9 |       0.000106 |       -9
    10 |       0.000016 |      -10
    11 |      -0.000002 |      -10
