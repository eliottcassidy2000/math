=== A1.1 the five known cycles of 3n+1 on Z ===
cycle of    0: length  1: [0]
      labels |4n+1|: [1]
      arcs: 0->0
cycle of    1: length  3: [1, 4, 2]
      labels |4n+1|: [5, 17, 9]
      arcs: 1->4, 4->2, 2->1
cycle of   -1: length  2: [-1, -2]
      labels |4n+1|: [3, 7]
      arcs: -1->-2, -2->-1
cycle of   -5: length  5: [-5, -14, -7, -20, -10]
      labels |4n+1|: [19, 55, 27, 79, 39]
      arcs: -5->-14, -14->-7, -7->-20, -20->-10, -10->-5
cycle of  -17: length 18: [-17, -50, -25, -74, -37, -110, -55, -164, -82, -41, -122, -61, -182, -91, -272, -136, -68, -34]
      labels |4n+1|: [67, 199, 99, 295, 147, 439, 219, 655, 327, 163, 487, 243, 727, 363, 1087, 543, 271, 135]
      arcs: -17->-50, -50->-25, -25->-74, -74->-37, -37->-110, -110->-55, -55->-164, -164->-82, -82->-41, -41->-122, -122->-61, -61->-182, -182->-91, -91->-272, -272->-136, -136->-68, -68->-34, -34->-17
total arcs: 29  distinct labels: 29
sorted labels: [1, 3, 5, 7, 9, 17, 19, 27, 39, 55, 67, 79, 99, 135, 147, 163, 199, 219, 243, 271, 295, 327, 363, 439, 487, 543, 655, 727, 1087]
