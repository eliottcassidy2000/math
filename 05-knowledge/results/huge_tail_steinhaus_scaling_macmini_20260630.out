  n=10: covmin(k=1)=n/Phi6=10/91;  M(k)=nk/(n(n-1)k+1) holds k=1..6: True;  M->1/(n-1)=1/9 as k->inf
  n=12: covmin(k=1)=n/Phi6=12/133;  M(k)=nk/(n(n-1)k+1) holds k=1..6: True;  M->1/(n-1)=1/11 as k->inf
  n=13: covmin(k=1)=n/Phi6=13/157;  M(k)=nk/(n(n-1)k+1) holds k=1..6: True;  M->1/(n-1)=1/12 as k->inf
