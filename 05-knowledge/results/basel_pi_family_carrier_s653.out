  top_order=['sine_product_elementary_packets', 'newton_log_derivative_power_sums', 'bernoulli_von_staudt_sieve', 'fourier_parseval_boundary', 'dirichlet_L_modular_periods', 'p_adic_zeta_denominator_audit', 'raw_numeric_pslq']
  score_hist={0: 1, 1: 1, 2: 1, 3: 1, 4: 1, 5: 1, 6: 1}
