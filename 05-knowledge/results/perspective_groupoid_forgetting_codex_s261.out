  normal_fan_component_packet: root=safe component; action=normal-fan chamber; next=component bound; sidecar=Cech/barcode word
  first_obstruction_cocycle: root=visible fiber pair; action=payload orbit; next=chart gluing; sidecar=obstruction syndrome
