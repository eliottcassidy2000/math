  Spectral -> interaction fibers (c3,c5) -> alpha_2:
    (c3,c5)=( 0, 0) -> alpha_2 in [0]
    (c3,c5)=( 1, 0) -> alpha_2 in [0]
    (c3,c5)=( 2, 0) -> alpha_2 in [0, 1]
