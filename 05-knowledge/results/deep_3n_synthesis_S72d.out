      ^^^ Contains eigenvalue 5 → accounts for β₁=1
      → C_T^TC_T eigs = n - these = [0.000, 2.000, 2.000, 4.000]
    C_R^TC_R|_{im(P)} nonzero eigs = [5.000, 3.000, 2.000, 2.000] × 40
      ^^^ Contains eigenvalue 5 → accounts for β₁=1
      → C_T^TC_T eigs = n - these = [0.000, 2.000, 3.000, 3.000]

  t₃=7, β₁=0 (120 tournaments):
    C_R^TC_R|_{im(P)} nonzero eigs = [4.414, 3.000, 1.586] × 120
      → C_T^TC_T eigs = n - these = [0.586, 2.000, 3.414]

  t₃=7, β₁=1 (120 tournaments):
    C_R^TC_R|_{im(P)} nonzero eigs = [5.000, 2.000, 2.000] × 120
