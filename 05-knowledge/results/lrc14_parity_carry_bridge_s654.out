F. Tournament Analysis over proof channels
  top_order=['no-multiple t=1/14 exit', 'carry parity word', 'apex congruence k=r mod 14', 'pair-sum congruence k_i+k_j=r_i+r_j', 'minimal-apex tax sweep', 'owner/Cprime certificate reattachment', 'raw Res_27 row identity']
  score_hist={0: 1, 1: 1, 2: 1, 3: 1, 4: 1, 5: 1, 6: 1}
