==========================================================================
A. UNIVERSALITY OF THE LEADING d^-2 CURVATURE ACROSS FIXED EDGES
==========================================================================
  curvature C(x,z) = 3x^2 - 2z - 1 = (-m1**4 - 2*m1*m3 + 3*m2**2)/m1**4
   k=2: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=3: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=4: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=5: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=6: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=7: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=8: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
   k=9: [d^0]=0? True   [d^-1]=0? True   [d^-2]==curvature? True
  VERDICT A: UNIVERSAL (k-independent, constant 1)

==========================================================================
