universe=one gentourng representative of every strong tournament isomorphism class, orders 3 through 9
generator=Homebrew nauty 2.9.3 /opt/homebrew/bin/gentourng
generator_filter=-c (strong tournaments); evaluator does not independently recheck strongness
word_format=upper triangle row by row; bit 1 means lower-labelled vertex points to higher-labelled vertex
compile=clang++ -std=c++17 -O3 -Wall -Wextra -pedantic 04-computation/tournament_strong_endpoint_five_copy_census_thm4219.cpp -o /tmp/census4219
run=for n in $(seq 3 9); do /opt/homebrew/bin/gentourng -q -c "$n" | /tmp/census4219; done
arithmetic=Hamilton DP and inequality in exact unsigned integers; ratio champion selected by checked unsigned-128 cross multiplication
variants=clang O0/O3 byte-match orders 3 through 9; ASan/UBSan passes order 7
