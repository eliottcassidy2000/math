========================================================================
  PART 7: If Cov = -(n-1)/2 * E[H], what is R^2?
========================================================================

  n=5:
    Var_S2 = 15/2
    (n-1)^2 * E[H]^2 = 900
    (n-1)^2 * E[H]^2 / 4 = 225
    Var_S2 * Var_H = 4275/32
    R^2 = 225 / 4275/32 = 18/19

  n=6:
    Var_S2 = 15
    (n-1)^2 * E[H]^2 = 50625/4
    (n-1)^2 * E[H]^2 / 4 = 50625/16
    Var_S2 * Var_H = 8775/4
    R^2 = 50625/16 / 8775/4 = 12/13

  n=7:
    Var_S2 = 105/4
    (n-1)^2 * E[H]^2 = 893025/4
    (n-1)^2 * E[H]^2 / 4 = 893025/16
    Var_S2 * Var_H = 21664125/512
    R^2 = 893025/16 / 21664125/512 = 120/131

  n=8:
    Var_S2 = 42
    (n-1)^2 * E[H]^2 = 4862025
    (n-1)^2 * E[H]^2 / 4 = 4862025/4
    Var_S2 * Var_H = 7799085/8
    R^2 = 4862025/4 / 7799085/8 = 120/131

