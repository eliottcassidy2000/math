[1] Exact Fejer / de-Moivre / Chebyshev identity
V_7(u) = u^7 - 7*u^5 + 14*u^3 - 7*u
m(u) = u^3 + u^2 - 2*u - 1
(V_7(u)-2)/(u-2) = u^6 + 2*u^5 - 3*u^4 - 6*u^3 + 2*u^2 + 4*u + 1
m(u)^2 = u^6 + 2*u^5 - 3*u^4 - 6*u^3 + 2*u^2 + 4*u + 1
identity_exact = True
disc(m) = 49 = 7^2
Fejer coefficients: -6:1, -5:2, -4:3, -3:4, -2:5, -1:6, 0:7, 1:6, 2:5, 3:4, 4:3, 5:2, 6:1

