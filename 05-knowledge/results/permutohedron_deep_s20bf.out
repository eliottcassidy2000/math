    Vol(Pi_6) = 6^4 = 1296 (Cayley trees)
    # labeled trees on [6]: 1296

======================================================================
  2. EULERIAN NUMBERS = h-VECTOR OF Pi_n
======================================================================

  n=3: Eulerian numbers = [1, 4, 1]
    Sum = 6 = 3! = 6
    Symmetric: True
    E[H] = n!/2^(n-1) = 3/2 = 1.50

  n=4: Eulerian numbers = [1, 11, 11, 1]
    Sum = 24 = 4! = 24
    Symmetric: True
    E[H] = n!/2^(n-1) = 3 = 3.00

  n=5: Eulerian numbers = [1, 26, 66, 26, 1]
    Sum = 120 = 5! = 120
    Symmetric: True
    E[H] = n!/2^(n-1) = 15/2 = 7.50

  n=6: Eulerian numbers = [1, 57, 302, 302, 57, 1]
    Sum = 720 = 6! = 720
    Symmetric: True
    E[H] = n!/2^(n-1) = 45/2 = 22.50

======================================================================
  3. H-SPECTRUM vs EULERIAN NUMBERS
======================================================================

  n=5:
  H-spectrum: {1: 120, 3: 120, 5: 240, 9: 240, 11: 120, 13: 120, 15: 64}
  Eulerian numbers: [1, 26, 66, 26, 1]

  H-generating polynomial: sum_T x^H(T) =
    120*x^1 + 120*x^3 + 240*x^5 + 240*x^9 + 120*x^11 + 120*x^13 + 64*x^15
  Eulerian polynomial A_5(t) =
    1*t^0 + 26*t^1 + 66*t^2 + 26*t^3 + 1*t^4

