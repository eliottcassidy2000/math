phi: A_3 -> A_3, phi(X1)=F1, phi(X2)=F2, phi(X3)=F3 (the JC counterexample),
phi(D_j) = sum_k B[j][k] D_k with B = (JF^T)^{-1}:

(R1) B*JF^T = I: True
(R2) all 9 flatness identities: True

B[0][0] = (-4)*x^3 + (3)*x^4*y + (3)*x^5*z + (9)*x^5*y^2 + (3)*x^6*y*z

B[0][1] = (-3)*x + (3)*x^2*y + (3)*x^3*z + (9)*x^3*y^2 + (3)*x^4*y*z

B[0][2] = (1)*1 + (21)*x*y + (9)*x^2*z + (-27)*x^2*y^2 + (-30)*x^3*y*z + (-54)*x^3*y^3 + (-9)*x^4*z^2 + (-45)*x^4*y^2*z + (-9)*x^5*y*z^2

B[1][0] = (3/2)*x^2 + (1/2)*x^3*y + (-3/2)*x^4*z + (-6)*x^4*y^2 + (-3)*x^5*y*z + (-9/2)*x^5*y^3 + (-3/2)*x^6*y^2*z

B[1][1] = (1)*1 + (-3/2)*x^2*z + (-6)*x^2*y^2 + (-3)*x^3*y*z + (-9/2)*x^3*y^3 + (-3/2)*x^4*y^2*z

B[1][2] = (-8)*y + (-3)*x*z + (3)*x*y^2 + (21/2)*x^2*y*z + (81/2)*x^2*y^3 + (9/2)*x^3*z^2 + (75/2)*x^3*y^2*z + (27)*x^3*y^4 + (9)*x^4*y*z^2 + (45/2)*x^4*y^3*z + (9/2)*x^5*y^2*z^2

B[2][0] = (1/2)*1 + (3/2)*x*y + (-3/2)*x^2*z + (-9/2)*x^2*y^2 + (-6)*x^3*y*z + (-16)*x^3*y^3 + (-9)*x^4*y^2*z + (-15)*x^4*y^4 + (-6)*x^5*y^3*z + (-9/2)*x^5*y^5 + (-3/2)*x^6*y^4*z

B[2][1] = (-3/2)*z + (-6)*y^2 + (-6)*x*y*z + (-33/2)*x*y^3 + (-9)*x^2*y^2*z + (-15)*x^2*y^4 + (-6)*x^3*y^3*z + (-9/2)*x^3*y^5 + (-3/2)*x^4*y^4*z

B[2][2] = (21/2)*y*z + (89/2)*y^3 + (9/2)*x*z^2 + (117/2)*x*y^2*z + (111)*x*y^4 + (18)*x^2*y*z^2 + (108)*x^2*y^3*z + (189/2)*x^2*y^5 + (27)*x^3*y^2*z^2 + (165/2)*x^3*y^4*z + (27)*x^3*y^6 + (18)*x^4*y^3*z^2 + (45/2)*x^4*y^5*z + (9/2)*x^5*y^4*z^2

