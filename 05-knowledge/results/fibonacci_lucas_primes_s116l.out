  n= 8: L_8^2 =     2209, 5*F_8^2 + 4*(-1)^8 =     2209  [OK]
  n= 9: L_9^2 =     5776, 5*F_9^2 + 4*(-1)^9 =     5776  [OK]
  n=10: L_10^2 =    15129, 5*F_10^2 + 4*(-1)^10 =    15129  [OK]
