on Omega: r (r u - 2) = r*(3*r**2 - 1),   6 r - u = (3*r**2 - 1)/r   (both nonzero)
d_u om = r*(r*u - 2)/(2*(3*r**2 - r*u + 1)),   d_v om = (6*r - u)/(2*(3*r**2 - r*u + 1))
d_u(psi/om^n) om^(n+2) + n psi r (r u - 2)/2 = (3*r**2 - r*u + 1)*(r**2*Derivative(psi(r, u), r) + 6*r**2*Derivative(psi(r, u), u) - 2*r*u*Derivative(psi(r, u), u) + 2*Derivative(psi(r, u), u))/2
d_v(psi/om^n) om^(n+2) + n psi (6 r - u)/2   = (3*r**2 - r*u + 1)*Derivative(psi(r, u), r)/2
h = x    pole order along Omega: h:  1;  d_u^m h, m = 1..6: [3, 5, 7, 9, 11, 13];  d_v^m h: [3, 5, 7, 9, 11, 13]
h = y    pole order along Omega: h:  0;  d_u^m h, m = 1..6: [1, 3, 5, 7, 9, 11];  d_v^m h: [1, 3, 5, 7, 9, 11]
h = w    pole order along Omega: h: -1;  d_u^m h, m = 1..6: [1, 3, 5, 7, 9, 11];  d_v^m h: [1, 3, 5, 7, 9, 11]
h = x y  pole order along Omega: h:  1;  d_u^m h, m = 1..6: [3, 5, 7, 9, 11, 13];  d_v^m h: [3, 5, 7, 9, 11, 13]
h = 1/w  pole order along Omega: h:  1;  d_u^m h, m = 1..6: [3, 5, 7, 9, 11, 13];  d_v^m h: [3, 5, 7, 9, 11, 13]
control: d_u^m (u) = 0 for m = 2
control: d_u^m (v) = 0 for m = 1
control: d_u^m (u v^2) = 0 for m = 2
