  chi(G[]H)    =? max(chi(G),chi(H))     [MAX, Hadwiger-Nelson -- NEUTRAL]
  i(G)i(H) <= i(G[]H) <= min(i(G),i(H))  [sub-MIN, lonely-runner -- DEGRADE]

