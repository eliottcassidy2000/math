  [NO MAP] {7,21} h-holes -> c(b) cycle counts :: 7 = c(11); 1,3 are the only odd holes of c(b) (S2.2)
  [NO MAP] {7,21} -> 63=2^6-1 / Mersenne :: 15,31,63 attained; 7 falls in inter-band gaps (THM-1745) (S2.1)
  [NO MAP FOUND] {7,21} -> {0,2,10} / rows {1,3,5} :: numerology S=7, S*U=21 only (S2.2)
  [MAP] Cipolla trunk (4^j-1)/3 -> inverse braid R(n)=4n+1 :: N_j = R^{j-1}(1); halving exponent 2j = ord_{N_j}(2); psp iff 6j | 4^j-4 (S2.3)
  [REFUTED] '341 stalls primitive primes' -> Zsigmondy :: 11, 31 primitive at j=5; no exception for base 4 (S2.3)
  [MAP (shift, not conjugacy)] 3N-5 -> Collatz :: T_{-5}(n) = T(n-2); rows precomposed by r -> r-2 (S4); cycles = -(3n+5 cycles) (inherited)
