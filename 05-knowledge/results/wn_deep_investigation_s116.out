========================================================================
  PART 6: N(n,j) — THE UNIT ASCENT DISTRIBUTION AMONG NUD PERMS
========================================================================

  N(n,j) = #{NUD permutations of [n] with exactly j unit ascents}
  W(n) = Σ_j N(n,j) × 2^j

  n=1: N(n,j) = [1]
    NUD(1) = 1 = A000255(1) = 1: True
    W(1) = Σ N(n,j)×2^j = 1: True

  n=2: N(n,j) = [0, 1]
    NUD(2) = 1 = A000255(2) = 3: False
    W(2) = Σ N(n,j)×2^j = 2: True

  n=3: N(n,j) = [0, 2, 1]
    NUD(3) = 3 = A000255(3) = 11: False
    W(3) = Σ N(n,j)×2^j = 8: True

  n=4: N(n,j) = [2, 5, 3, 1]
    NUD(4) = 11 = A000255(4) = 53: False
    W(4) = Σ N(n,j)×2^j = 32: True

  n=5: N(n,j) = [14, 20, 14, 4, 1]
    NUD(5) = 53 = A000255(5) = 309: False
    W(5) = Σ N(n,j)×2^j = 158: True

  n=6: N(n,j) = [90, 115, 72, 26, 5, 1]
