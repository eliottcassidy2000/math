  n= 8: E[c₅] = 21 = 21.00
  n= 9: E[c₅] = 189/4 = 47.25
  n=10: E[c₅] = 189/2 = 94.50
  n=11: E[c₅] = 693/4 = 173.25
  n=12: E[c₅] = 297 = 297.00


