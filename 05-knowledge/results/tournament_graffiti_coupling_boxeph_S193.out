-- operation Dminus --
   c3      Delta = +0   (CONSTANT: c3 and this op are frozen)
   H       Delta = +0   (CONSTANT: H and this op are frozen)
   tr      Delta = +1   (CONSTANT: tr and this op are coupled(+))
