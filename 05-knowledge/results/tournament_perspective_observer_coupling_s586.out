  ranking=[(43, 'endpoint_owner_sheaf'), (41, 'observer_source_threshold'), (37, 'proof_obligation_automaton'), (27, 'root_plus_incident_word'), (14, 'observer_pointed_class'), (6, 'unmarked_A000568_class')]
