    (   9,  9): nt=  1, (bk,bl)=(0, 1) [UNIVERSAL ✓]
    (  11,  1): nt= 11, (bk,bl)=(8, 3) [UNIVERSAL ✓]
    (  13,  1): nt= 13, (bk,bl)=(10, 3) [UNIVERSAL ✓]
    (  15,  3): nt=  5, (bk,bl)=(4, 1) [UNIVERSAL ✓]
    (  15,  5): nt=  3, (bk,bl)=(0, 3) [UNIVERSAL ✓]
    (  17,  1): nt= 17, (bk,bl)=(12, 5) [UNIVERSAL ✓]
