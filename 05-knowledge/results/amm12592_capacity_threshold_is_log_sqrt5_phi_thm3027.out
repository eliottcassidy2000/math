============================================================================
C. EXACT SOLUTION OF THE TANGENCY SYSTEM (symbolic, 40 dps)
============================================================================
    tau* = (1-u)/(1+u)         = 0.3819660112501051517954131656343618822797
    phi^-2 = 2 - phi           = 0.3819660112501051517954131656343618822797
    (1-tau)^2 - tau            = -1.147943701974890144500719274631099294745e-41      <-- eq (!)

    (S)  gamma A               = 0.4812118250596034474977589134243684231352
         log(2u/(1-u))         = 0.4812118250596034474977589134243684231352
         residual              = -5.739718509874450722503596373155496473724e-42
    (T)  2u/(1-u)              = 1.61803398874989484820458683436563811772
         (1-tau)/tau           = 1.61803398874989484820458683436563811772
         residual              = 2.29588740394978028900143854926219858949e-41

    KEY IDENTITY  H(rho) + rho log2 = A (1 + gamma rho):
         LHS                   = 1.070726310794651615353421963562159530186
         RHS                   = 1.070726310794651615353421963562159530186
         residual              = 0.0

    D = gamma(1+tau)/(1+gamma rho) = 0.6210909172022238526076006340016804768735
    sigma* = tau - rho D           = 0.03863539626225450537829621233709417860752   interior: True

    (V)  D[H(rho)+rho log2]    = 0.6650183864440035701326057423726642760572
         H(tau)                = 0.6650183864440035701326057423726642760573
         residual              = -2.29588740394978028900143854926219858949e-41

    (V) reduces to 2 log(1-tau) = log tau, i.e. (1-tau)^2 = tau,
    i.e. tau^2 - 3 tau + 1 = 0 -- the minimal polynomial of phi^2.
         phi^2 - phi - 1       = 0.0
  VERDICT C: all of (S),(T),(V) and the key identity vanish to 30+ dps,
             sigma* interior: True

