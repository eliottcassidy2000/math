    (0, 1, 3, 3, 3): mean_err=-10.00, max_err=10
    (0, 2, 2, 2, 4): mean_err=-10.00, max_err=10
    (0, 2, 2, 3, 3): mean_err=-8.00, max_err=8
    (1, 1, 1, 3, 4): mean_err=-10.00, max_err=10
    (1, 1, 2, 2, 4): mean_err=-8.00, max_err=8
    (1, 1, 2, 3, 3): mean_err=-4.50, max_err=8
