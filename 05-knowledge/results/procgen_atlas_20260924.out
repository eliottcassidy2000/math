==============================================================================
  g0=  1: xi=1.6222705029  #n<40 with f_n >= 1/2: 13  max|{xi(3/2)^n} - f_n| = 0.0e+00
  g0=  2: xi=2.4334057543  #n<40 with f_n >= 1/2: 12  max|{xi(3/2)^n} - f_n| = 0.0e+00
