    classical kappa_k   : ['0', '0', '24/7', '44/7', '10', '-4080/49', '-4650/7']
    free      k_k       : ['0', '0', '24/7', '44/7', '10', '-48/49', '-426/7']
    free_k  == W_k      ? False
    classical_k == W_k  ? False
    free_k  == W_k/n    ? False

  tournament #5 (n=7):
    traces trA^k        : [0, 0, 30, 60, 100, 372, 1078]
    W_k (necklace)      : [0, 0, 10, 15, 20, 57, 154]
    moments m_k=trA^k/n : ['0', '0', '30/7', '60/7', '100/7', '372/7', '154']
