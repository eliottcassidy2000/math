    moments m_k=trA^k/n : ['0', '0', '36/7', '96/7', '115/7', '498/7', '290']
    classical kappa_k   : ['0', '0', '36/7', '96/7', '115/7', '-9474/49', '-15250/7']
    free      k_k       : ['0', '0', '36/7', '96/7', '115/7', '-402/49', '-1426/7']
    free_k  == W_k      ? False
    classical_k == W_k  ? False
    free_k  == W_k/n    ? False

  tournament #4 (n=7):
    traces trA^k        : [0, 0, 24, 44, 70, 240, 630]
