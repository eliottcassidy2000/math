double_face=-Phi*Y*a**3 - W*X**2*a**3 + W*X**2*a**2*c + Y**2 - Y*a**5*alpha - Y*a**4*eta
triple_face=-Phi*Y*a**3 - W*X**3*a**2 + Y**2 - Y*a**5*alpha - Y*a**4*eta
triple_B_simple_zero_face=-W*X**3*a**2 - X*Y*a**3*j1 + Y**2
triple_B_simple_zero_normalization=Z^2=a^2*W*X+a^6*j1^2/4;rational
good_form_orders=double:28,triple:26,triple_B_simple_zero:46
