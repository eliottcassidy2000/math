global_ledgers={0: (42, 14, 15), 1: (40, 12, 15), 2: (38, 12, 14), 3: (36, 10, 14)}
edges_KWU_Lambda_open=(edge_x - 1, -K*edge_x**2 + 1, K + Theta*edge_x + W*edge_x**3 + edge_x**2*xi, (edge_x - 1)*(U*edge_x + W), U - edge_x**6, -W*edge_x + 1)
face_orders_L12=M:9,T:16
global_relative_gate=U*K*W*(U+W)!=0;all_cubic_root_strata_PASS
