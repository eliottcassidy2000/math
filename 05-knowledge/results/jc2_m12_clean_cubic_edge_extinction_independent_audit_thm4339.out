THM4339_CLEAN_CUBIC_EDGE_INDEPENDENT_AUDIT=PASS
A=K+Theta*P+xi*P^2+W*P^3
Disc=-27*K**2*W**2 + 18*K*Theta*W*xi - 4*K*xi**3 - 4*Theta**3*W + Theta**2*xi**2
Delta0=xi^2-3*W*Theta
4*Delta0^3-Delta1^2=27*W^2*Disc
double_root=(9*W*K-xi*Theta)/(2*Delta0)
double_Hasse_numerator=81*K**2*W**2*alpha - 54*K*Theta*W**2*eta - 18*K*Theta*W*alpha*xi + 18*K*W*eta*xi**2 + 36*Phi*Theta**2*W**2 - 24*Phi*Theta*W*xi**2 + 4*Phi*xi**4 + 6*Theta**2*W*eta*xi + Theta**2*alpha*xi**2 - 2*Theta*eta*xi**3
triple_gates=Delta0=0;2*xi^3-9*W*xi*Theta+27*W^2*K=0
triple_Hasse_numerator=9*Phi*W**2 - 3*W*eta*xi + alpha*xi**2
critical_value=[-B(a)^2/4]*delta^2+O(delta^3);delta=sigma^6
