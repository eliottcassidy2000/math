############################################################################################
# THREAD 3 / NODE 3 : THE SPECTRUM-INTERSECTION SUM  (kind-pasteur kpswf12)
#   R' = 1 + SPEC/baseline,  SPEC = sum_{n!=0} chat(n) conj(ghat(n))
#   chat = G_P indicator coeffs (P-lattice/Bohr support, HYP-2606)
#   ghat = cover^c indicator coeffs (1/n decay, BV)
############################################################################################
============================================================================================
  (k=8 consec, P=worst-ish)  P=[1, 2, 3, 12, 13]
            E=[0, 1, 2, 3, 4, 5, 6, 7]   (k=8)
============================================================================================
  meas(G_P)              = 177/364 = 0.48626374
  p0 = meas(coverSet)    = 481/1470 = 0.32721088
  1-p0 = meas(cover^c)   = 989/1470 = 0.67278912
  baseline = G_P*(1-p0)  = 58351/178360 = 0.32715295
  meas(cover^c cap G_P)  = 4583/19110 = 0.23982208
  -- SPEC (exact, real-space) = inter - baseline = -46729/535080 = -0.08733087
  -- R' = inter/baseline      = 128324/175053 = 0.73305799
  spectral SPEC (|n|<= 4000)   = -0.08733136   (-> exact -0.08733087)
     agreement |spec-exact|   = 4.91e-07
  partial-sum trace (n, cumulative SPEC):
       n<=     1:  -0.00190578
       n<=     2:  -0.01403835
       n<=     3:  -0.02189743
       n<=     5:  -0.03270951
       n<=     7:  -0.07322374
       n<=    10:  -0.07008699
       n<=    20:  -0.09617555
       n<=    50:  -0.08675709
       n<=   100:  -0.08743178
       n<=   200:  -0.08719907
       n<=   500:  -0.08732585
       n<=  1000:  -0.08731674
       n<=  2000:  -0.08733012
       n<=  4000:  -0.08733136
  LOW/HIGH split at Hlow=20:
     sum_low (|n|<=20)     = -0.09617555
     sum_high (20<|n|<=4000) = +0.00884419
     #jumps G_P  Vc = 32,  #jumps cover^c  Vg = 22
     ABS tail bound |sum_{|n|>20}| <= Vc*Vg/(4pi^2) * 2/20 = 1.783253
  --> R' >= c  with c = R' itself = 0.733058.
      SPEC<0: |SPEC|=0.08733087 = (1-R')*baseline, (1-R')=0.266942

