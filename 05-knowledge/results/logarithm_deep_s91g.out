    k= 5, 1/ 11: v_3(1/11) = +0
    k= 6, 1/ 13: v_3(1/13) = +0
    k= 7, 1/ 15: v_3(1/15) = -1 <-- POLE
    k= 8, 1/ 17: v_3(1/17) = +0
    k= 9, 1/ 19: v_3(1/19) = +0
    k=10, 1/ 21: v_3(1/21) = -1 <-- POLE
    k=11, 1/ 23: v_3(1/23) = +0

  p = 5: v_p(1/(2k+1)) for the first coefficients:
    k= 0, 1/  1: v_5(1/1) = +0
    k= 1, 1/  3: v_5(1/3) = +0
    k= 2, 1/  5: v_5(1/5) = -1 <-- POLE
    k= 3, 1/  7: v_5(1/7) = +0
    k= 4, 1/  9: v_5(1/9) = +0
    k= 5, 1/ 11: v_5(1/11) = +0
    k= 6, 1/ 13: v_5(1/13) = +0
