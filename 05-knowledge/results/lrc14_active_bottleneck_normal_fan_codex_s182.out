[TOURNAMENT ANALYSIS]
vertices=proof carriers / local certificate schemas, not runners
observable=(predicate, local_bottleneck_support, endpoint_geometry, quotient_purity_repair, stability, handoff_quality, anti_scalar)
switch=majority comparison; tie path=listed carrier order
score_hist={0: 1, 1: 1, 2: 1, 3: 1, 4: 1, 5: 1, 6: 1, 7: 1}
directed_3cycles=0
scc_sizes=[1, 1, 1, 1, 1, 1, 1, 1]
hamiltonian_path_count=1
tie_path=active_bottleneck_normal_fan > lonely_profile_persistence_barcode > tope_cocircuit_wall_language > fejer_interval_certificate > exact_safe_component_front > automaton_fiber_magnitude_cocycle > raw_maximin_scalar > raw_automaton_word
score_order=active_bottleneck_normal_fan > lonely_profile_persistence_barcode > tope_cocircuit_wall_language > fejer_interval_certificate > exact_safe_component_front > automaton_fiber_magnitude_cocycle > raw_maximin_scalar > raw_automaton_word
  active_bottleneck_normal_fan: score=7 vector=(3, 3, 3, 3, 3, 3, 3) note=keeps the local active inequalities at endpoints and peaks
  lonely_profile_persistence_barcode: score=6 vector=(3, 2, 2, 2, 3, 3, 3) note=keeps open bars, heights, lengths, and persistence margins
  tope_cocircuit_wall_language: score=5 vector=(3, 2, 3, 2, 2, 3, 3) note=keeps wall/topology and endpoint cocircuits but not peak support
  fejer_interval_certificate: score=4 vector=(3, 2, 2, 2, 3, 3, 3) note=dual certificate after an interval and packet are chosen
  exact_safe_component_front: score=3 vector=(3, 1, 2, 1, 2, 3, 3) note=knows strict components but not the bottleneck normal fan
  automaton_fiber_magnitude_cocycle: score=2 vector=(2, 1, 1, 3, 2, 2, 3) note=repairs mixed automatic fibers by retaining Farey/magnitude data
  raw_maximin_scalar: score=1 vector=(1, 0, 0, 1, 1, 0, 1) note=knows M but forgets local owners and topology
  raw_automaton_word: score=0 vector=(0, 0, 0, 0, 0, 0, 0) note=can mix AP/GW boundary atoms with open rows
