    E_correct = (T - SL - excess)/2 = 5
    E_formula2 = (3T-S2)/4 = 5
    actual E = 5
    Match naive: True, Match correct: True
    SL=6, D_self=6, SL-2*D_self=-6
    SL + excess - D = 6 + 0 - 6 = 0 (should be 0 if E=(T-D)/2 worked)

