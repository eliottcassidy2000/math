[4] TOURNAMENT ANALYSIS
  vertices=proof carriers, not runners
  pairwise_observable=which carrier decides threshold branch while retaining unit index and blind residue/height sidecars
  switch/gauge=A beats B by majority over branch decision, unit index, blind residue/height, covering, endpoint, formalization criteria
  strict_safe_component_atlas         vector=(5, 5, 4, 5, 5, 4) score=5 note=decides boundary-only vs positive open mass and keeps endpoints
  unit_plus_blind_residue_height_ledger vector=(5, 4, 5, 4, 4, 5) score=4 note=keeps unit index plus blind residue and height sidecars
  covering_14_multiple_kill_switch    vector=(4, 3, 4, 5, 4, 5) score=3 note=detects the covering branch where all unit points are killed
  unit_active_gradient_rank           vector=(3, 5, 1, 2, 3, 5) score=2 note=computes the local Chebyshev/index coordinate but forgets nonunits
  full_unit_residue_signature         vector=(3, 4, 2, 2, 3, 4) score=1 note=records the three binding complement pairs
  raw_unit_values                     vector=(2, 3, 0, 1, 2, 5) score=0 note=knows only exact/slack/killed values at a/14
  score_hist={0: 1, 1: 1, 2: 1, 3: 1, 4: 1, 5: 1}
