   p^2  Apery A (zeta3)                                  ~ trunc 4F3 sum_{k<=(p-1)/2} C(2k,k)^4/256^k       twist (1/p)
   p    Domb                                             ~ Franel4 (=s10)                                   twist (-1/p)
   p    Domb                                             ~ Cooper s7                                        twist (1/p)
   p    Domb                                             ~ sum C(2k,k)^2 C(2n-2k,n-k)^2                     twist (-1/p)
   p    Domb                                             ~ trunc 4F3 sum_{k<=(p-1)/2} C(2k,k)^4/256^k       twist (-1/p)
   p    Almkvist-Zudilin                                 ~ Cooper s18                                       twist (-1/p)
   p    Franel4 (=s10)                                   ~ Cooper s7                                        twist (-1/p)
   p    Franel4 (=s10)                                   ~ sum C(2k,k)^2 C(2n-2k,n-k)^2                     twist (1/p)
   p    Franel4 (=s10)                                   ~ trunc 4F3 sum_{k<=(p-1)/2} C(2k,k)^4/256^k       twist (1/p)
   p    Cooper s7                                        ~ sum C(2k,k)^2 C(2n-2k,n-k)^2                     twist (-1/p)
   p^2  Cooper s7                                        ~ trunc 4F3 sum_{k<=(p-1)/2} C(2k,k)^4/256^k       twist (-1/p)
   p    Apery b (zeta2)                                  ~ Zagier B                                         twist (1/p)
   p    Apery b (zeta2)                                  ~ Zagier B                                         twist (-1/p)
   p^2  Apery b (zeta2)                                  ~ trunc 3F2 sum_{k<=(p-1)/2} C(2k,k)^3/64^k        twist (1/p)
   p^2  Apery b (zeta2)                                  ~ trunc 3F2 sum_{k<=(p-1)/2} C(2k,k)^3/64^k        twist (-1/p)
   p    Franel                                           ~ Zagier E                                         twist (-1/p)
   p    Franel                                           ~ Zagier E                                         twist (2/p)
   p    Zagier C                                         ~ sum C(n,k)C(2k,k)C(2n-2k,n-k)^2/...: C(2n,n)sum C(n,k)^2 C(2k,k) twist (-1/p)
   p    Zagier C                                         ~ sum C(n,k)C(2k,k)C(2n-2k,n-k)^2/...: C(2n,n)sum C(n,k)^2 C(2k,k) twist (3/p)
   p    Zagier B                                         ~ trunc 3F2 sum_{k<=(p-1)/2} C(2k,k)^3/64^k        twist (1/p)
   p    Zagier B                                         ~ trunc 3F2 sum_{k<=(p-1)/2} C(2k,k)^3/64^k        twist (-1/p)
