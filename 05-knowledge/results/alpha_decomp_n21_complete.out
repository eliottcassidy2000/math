α₂ = 12,330,182,836,208     (2-packings of vertex-disjoint odd cycles)
α₃ =  4,796,354,751,404     (3-packings)
α₄ =    738,531,326,288     (4-packings)
α₅ =     58,868,297,768     (5-packings)
α₆ =      1,454,221,328     (6-packings: 6×triangle or 5×triangle+pentagon)
α₇ =         12,571,712     (7-packings: ONLY type is 7×triangle, covers all 21 vertices)

