TOURNAMENT_ANALYSIS
vertices=labelled_lrc_packet_sheaf,modular_cusp_principal_part,full_modular_group_invariance_gate,q_pochhammer_eta_tail,hurwitz_vieta_seed_orbit,continued_fraction_markov_address,pell_wall_unit_address,raw_q_series_coefficients,raw_hurwitz_scalar
