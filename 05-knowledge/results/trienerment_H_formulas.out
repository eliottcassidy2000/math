  E[H-|k,n] = (n!/2^{n-1}) * C(C(n-1,2),k) / C(C(n,2),k)
  f_n(x) = (1+2x)^{n-1}*(1+x)^{C(n-1,2)},  f_n(-1)=0 for n>=3
