n = 1
##############################################################################
non-isomorphic graphs on 1 vertices: 1

--- TASK 1: G has Ham PATH  <=>  exists order, spine all-forward ---
  match: 1   mismatch: 0
  NO counterexample: equivalence holds (tautology confirmed).

--- TASK 2: G has Ham CYCLE  <=>  ? ---
  Contingency [G-HamCycle x T_G-strong(natural order)]:
    HC=0,strong=0: 0   HC=0,strong=1: 1
    HC=1,strong=0: 0   HC=1,strong=1: 0
  Contingency [G-HamCycle x exists-order T_G strong]:
    HC=0,exS=0: 0   HC=0,exS=1: 1
    HC=1,exS=0: 0   HC=1,exS=1: 0
  Contingency [G-HamCycle x exists-order spine+wrap]:
    HC=0,sw=0: 1   HC=0,sw=1: 0
    HC=1,sw=0: 0   HC=1,sw=1: 0
  HC => exists-order-strong (no counterexample): True
  exists-order-strong => HC (no counterexample): False
  HC <=> exists-order spine+wrap (no counterexample): True

--- TASK 3: full 5-way contingency ---
  key = (HamPath, HamCycle, strongNat, existsStrong, Alcuin-vs-tau)
    (1, 0, 1, 1, 'tau+1') : 1
  Alcuin == tau:   0
  Alcuin == tau+1: 1
  Alcuin other:    0

