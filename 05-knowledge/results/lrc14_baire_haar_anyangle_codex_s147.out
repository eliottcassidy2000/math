  observable tuple:
    measurability retention, interval-node strength, taut-wall retention,
    finite-atlas fit, dynamic-update fit, scalar-decoy resistance
  score_hist={0: 1, 1: 1, 2: 1, 3: 1, 4: 1, 5: 1} directed_3cycles=0
