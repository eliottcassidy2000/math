[a] GNOMON SHELLS for ODD n  (shell i = nesting level; widths 1,3,5,...,2k-1)
    survival(a,b)=min(b, n+1-a) is rho-invariant; shell = smax - survival + 1
    shell 1 = innermost (deepest Mode-B core), shell k = outermost (apex layer)

  --- n=3 (k=1, half=1, smax=1) ---
    shell 1 (width 1): (3, 1)[FIX,rc=(1, 1),surv=1]
    -> shell widths [1]  vs gnomon [1]  OK (1,3,5,... gnomon)

  --- n=5 (k=2, half=4, smax=2) ---
    shell 1 (width 1): (4, 2)[FIX,rc=(1, 2),surv=2]
    shell 2 (width 3): (3, 1)~(5, 3)[pair,rc=(1, 1),surv=1]  (4, 1)~(5, 2)[pair,rc=(2, 1),surv=1]  (5, 1)[FIX,rc=(3, 1),surv=1]
    -> shell widths [1, 3]  vs gnomon [1, 3]  OK (1,3,5,... gnomon)

  --- n=7 (k=3, half=9, smax=3) ---
    shell 1 (width 1): (5, 3)[FIX,rc=(1, 3),surv=3]
    shell 2 (width 3): (4, 2)~(6, 4)[pair,rc=(1, 2),surv=2]  (5, 2)~(6, 3)[pair,rc=(2, 2),surv=2]  (6, 2)[FIX,rc=(3, 2),surv=2]
    shell 3 (width 5): (3, 1)~(7, 5)[pair,rc=(1, 1),surv=1]  (4, 1)~(7, 4)[pair,rc=(2, 1),surv=1]  (5, 1)~(7, 3)[pair,rc=(3, 1),surv=1]  (6, 1)~(7, 2)[pair,rc=(4, 1),surv=1]  (7, 1)[FIX,rc=(5, 1),surv=1]
    -> shell widths [1, 3, 5]  vs gnomon [1, 3, 5]  OK (1,3,5,... gnomon)

  --- n=9 (k=4, half=16, smax=4) ---
    shell 1 (width 1): (6, 4)[FIX,rc=(1, 4),surv=4]
    shell 2 (width 3): (5, 3)~(7, 5)[pair,rc=(1, 3),surv=3]  (6, 3)~(7, 4)[pair,rc=(2, 3),surv=3]  (7, 3)[FIX,rc=(3, 3),surv=3]
    shell 3 (width 5): (4, 2)~(8, 6)[pair,rc=(1, 2),surv=2]  (5, 2)~(8, 5)[pair,rc=(2, 2),surv=2]  (6, 2)~(8, 4)[pair,rc=(3, 2),surv=2]  (7, 2)~(8, 3)[pair,rc=(4, 2),surv=2]  (8, 2)[FIX,rc=(5, 2),surv=2]
    shell 4 (width 7): (3, 1)~(9, 7)[pair,rc=(1, 1),surv=1]  (4, 1)~(9, 6)[pair,rc=(2, 1),surv=1]  (5, 1)~(9, 5)[pair,rc=(3, 1),surv=1]  (6, 1)~(9, 4)[pair,rc=(4, 1),surv=1]  (7, 1)~(9, 3)[pair,rc=(5, 1),surv=1]  (8, 1)~(9, 2)[pair,rc=(6, 1),surv=1]  (9, 1)[FIX,rc=(7, 1),surv=1]
    -> shell widths [1, 3, 5, 7]  vs gnomon [1, 3, 5, 7]  OK (1,3,5,... gnomon)

