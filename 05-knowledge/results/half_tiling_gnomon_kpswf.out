[0] half(n) = floor((n-1)^2/4):  odd k^2 (gnomon square) / even k(k-1) (pronic)
  n    m  d=fix  pairs  half                  shape  half(n)-half(n-2)
  3    1      1      0     1         odd k=1: k^2=1                  1
  4    3      1      1     2     even k=2: k(k-1)=2                  2
  5    6      2      2     4         odd k=2: k^2=4                  3
  6   10      2      4     6     even k=3: k(k-1)=6                  4
  7   15      3      6     9         odd k=3: k^2=9                  5
  8   21      3      9    12    even k=4: k(k-1)=12                  6
  9   28      4     12    16        odd k=4: k^2=16                  7
 10   36      4     16    20    even k=5: k(k-1)=20                  8
 11   45      5     20    25        odd k=5: k^2=25                  9
 12   55      5     25    30    even k=6: k(k-1)=30                 10
 13   66      6     30    36        odd k=6: k^2=36                 11

