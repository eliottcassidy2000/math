    del_betas=[1, 0, 0, 0] → β₁=0  (sum=1, max=1)
    del_betas=[1, 0, 0, 1] → β₁=1  (sum=2, max=1)
    del_betas=[1, 0, 1, 0] → β₁=1  (sum=2, max=1)
